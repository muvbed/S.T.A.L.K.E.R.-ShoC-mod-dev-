suicide_speed_rot = 0.0901 			;скорость суицида, не ставить меньше дрожания
no_other_hud_moving_while_suicide = true	;не смешивать суицидальное смещение с наклонами движения
suicide_delay = 0.2				;время от выстрела до зажмуривания
controller_time = 3				;время, на которое контролер будет захватывать контроль над игроком с данным оружием (если используется самоубийство смещением координат, то имеет смысл ставить побольше, иначе - поменьше, пару секунд). 

controller_g_attack_min_dist = 10; если дистанция меньше - контролер не будет пытаться подорвать актора греной
controller_shoot_expl_min_dist = 10; если дистанция меньше - контролер не будет пытаться подорвать актора из РПГ или РГ-6
controller_shoot_gl_min_dist = 10; если дистанция меньше - контролер не будет пытаться подорвать актора из подствола
controller_can_shoot_gl = false; может ли контролер стрелять из подствола
controller_can_switch_gl = false; может ли контролер отключать подствол

