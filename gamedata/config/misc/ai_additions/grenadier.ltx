;--------------------------------------
; Модуль grenadier
; xStream, Rulix aka Bak
;--------------------------------------

[main]
check_period		= 2300	;мс ; время между проверками
forbidden_factions	= zombied,prezombied	; группировки, для которых схема будет отключена полностью (community)
min_dist			= 20	;м ; ближе нельзя кидать
max_dist			= 50		;м ; дальше не можем (для максимального ранга персонажа)
mark_dist			= 35	;м ; радиус подсветки гранат на экране

; настройки респавна гранат в инвентарь
spawn_period		= 15		;сек ; время респавна гранат ; основной параметр, влияющий на частоту швыряний
max_grenade_num		= 2	; максимальное кол-во гранат у персонажа (разных типов гранат)

[forbidden_npcs];имена, профили НПС, для которых схема будет отключена полностью (name,profile_name)
mil_stalker0012
yantar_ecolog_general


; настройки схемы Камикадзе
[psyh]
actor_only	= false		; атаковать только игрока
factions	= monolith	; список группировок, которые будут использовать схему
chance		= 0.2		; вероятность стать психом камикадзе


;---------------------------------------
[attack_classes] ;в кого можно швыряться
actor
stalker

bloodsucker
boar
burer
cat
chimera
controller
dog
flesh
giant
pseudodog
psy_dog
psy_dog_phantom
snork
tushkano
zombie

; Profiles
;---------------------------------------
; по умолчанию читается профиль группировки

[default]
throw		= true		; можно ли кидаться
evasion		= true		; можно ли уклоняться
; список гранат для спавна, секция:шанс, сумма не должна быть больше 100
spawn_grenades	= grenade_rgd5:40,grenade_f1:15

[stalker]:default

[bandit]:default
spawn_grenades	= grenade_rgd5:45,grenade_f1:10

[prebandit]:bandit

[freedom]:default
spawn_grenades	= grenade_rgd5:30,grenade_f1:25

[prefreedom]:freedom

[dolg]:default
spawn_grenades	= grenade_rgd5:25,grenade_f1:30

[predolg]:dolg

[killer]:default
spawn_grenades	= grenade_rgd5:5,grenade_f1:50

[military]:default
spawn_grenades	= grenade_rgd5:25,grenade_f1:30

[premilitary]:military

[monolith]:default

[ecolog]:default
throw = false
spawn_grenades	= grenade_rgd5:0,grenade_f1:0

[trader]:default
throw = false
spawn_grenades	= grenade_rgd5:0,grenade_f1:0

; custom

[dont_throw]:default
throw = false
spawn_grenades	= grenade_rgd5:0,grenade_f1:0
