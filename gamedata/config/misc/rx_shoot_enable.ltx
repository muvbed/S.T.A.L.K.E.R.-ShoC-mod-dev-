;--------------------------------------
;[shoot_effect_base] ; форма
strength		= 1 ; сила отдачи от 1 до 5
strength_rnd	= 0 ; рандом(1), по порядку(0), рандом после первого выстрела(2)

; целая часть - интенсивность, дробная - рандомность (если интенсивность > 4)
0	= 0.0,0	; сдвиг вправо(0) влево (1)
1	= 0.0,0	; сдвиг вверх(0) вниз (1)
2	= 0.0,0	; сдвиг вперед(0) назад (1)
3	= 0.0,0	; поворот вправо(0) влево (1)
4	= 0.0,0	; наклон вниз(1) вверх (0)
5	= 0.0,0	; наклон влево(1) вправо (0)

;  кастомные анимации
fusker		= 0.0,anm

; постпроцесс
black		= 0.0,ppe
blur		= 0.0,ppe
grey		= 0.0,ppe
duality_h	= 0.0,ppe
duality_v	= 0.0,ppe
fire_hit	= 0.0,ppe

