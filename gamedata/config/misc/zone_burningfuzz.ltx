;----------- Аномалия Тополиный пух -----------------------
[zone_burning_fuzz1]
script_binding      		= ogse_dbg_anomaly_binder.init

GroupControlSection			= spawn_group_zone
$spawn 						= "zones\burning fuzz1"
$prefetch 					= 16
class						= ZS_BFUZZ
visual						= physics\anomaly\topolinypuh 
hit_impulse_scale			= 0
effective_radius			= 50.0 					;0.75 ;размер радиуса в процентах от оригинального, где действует зона
max_velocity_in_zone		= 0.1
sound						= zone_mosquito_bald
postprocess					= postprocess_fuzz

ef_anomaly_type				= 6
ef_weapon_type				= 18

artefacts					= af_rusty_thorn,0.6, af_rusty_kristall,0.3, af_rusty_sea-urchin,0.1
BirthProbability 			= 0.1
artefact_spawn_probability 	= 0.1					;вероятность, что во время срабатывания аномалии будет рожден артефакт
artefact_spawn_rnd			= 10

artefact_spawn_particles 	= anomaly2\pux_blast	;партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound 		= anomaly\pux_blast		;звук, который отыграются на месте рождения артефакта (опционально)

throw_out_power 			= 10	;импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height 		= 1		;(м) высота на центром зоны где будет рожден артефакт

;----------- Anomaly settings -----------------------
min_start_power				= 0.2 
max_start_power				= 0.4 
attenuation					= 1
period						= 1
min_artefact_count			= 0
max_artefact_count			= 1
artefact_spawn_idle			= 24  ;насколько часто спонить артефакты в офлайне, в часах

min_speed_to_react 			= 3.0

hit_type					= chemical_burn
hit_effect					= anomaly2\hit_metal_02

idle_particles				= anomaly2\pux_idle
blowout_particles			= anomaly2\pux_blast

idle_small_particles		= anomaly2\pux_damage_smoke_01
idle_big_particles			= anomaly2\pux_damage_smoke_02

blowout_sound				= anomaly\bfuzz_blowout
hit_sound					= anomaly\bfuzz_hit

disable_time				= 500	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small			= 500	;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time			= 1000	;время отключения idle партиклов

awaking_time				= 50 
blowout_time				= 1000 	
accamulate_time				= 5000

throw_in_impulse_alive		= 1000

attack_animation_start		= 10
attack_animation_end		= 1000

ignore_nonalive				= false	;
ignore_small				= false	;
ignore_artefacts			= true

blowout_light				= off
idle_light					= off

visible_by_detector 		= on

blowout_wind				= off

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;рождение артефактов во время срабатывания
spawn_blowout_artefacts 	= off

[zone_burning_fuzz_weak]:zone_burning_fuzz1
$spawn 						= "zones\burning fuzz weak"

;----------- Anomaly settings -----------------------
min_start_power				= 0.1 
max_start_power				= 0.3 

artefacts					= af_rusty_thorn,0.6, af_rusty_kristall,0.3, af_rusty_sea-urchin,0.1
BirthProbability 			= 0.1
artefact_spawn_probability 	= 0.1					;вероятность, что во время срабатывания аномалии будет рожден артефакт
artefact_spawn_rnd			= 10

[zone_burning_fuzz_average]:zone_burning_fuzz1
$spawn 						= "zones\burning fuzz average"

;----------- Anomaly settings -----------------------
min_start_power				= 0.2 
max_start_power				= 0.4 

artefacts					= af_rusty_thorn,0.5, af_rusty_kristall,0.3, af_rusty_sea-urchin,0.2
BirthProbability 			= 0.2
artefact_spawn_probability 	= 0.2					;вероятность, что во время срабатывания аномалии будет рожден артефакт
artefact_spawn_rnd			= 20

[zone_burning_fuzz_strong]:zone_burning_fuzz1
$spawn 						= "zones\burning fuzz strong"

;----------- Anomaly settings -----------------------
min_start_power				= 0.3 
max_start_power				= 0.5 

artefacts					= af_rusty_thorn,0.4, af_rusty_kristall,0.3, af_rusty_sea-urchin,0.2, af_fuzz_kolobok,0.1
BirthProbability 			= 0.3
artefact_spawn_probability 	= 0.3					;вероятность, что во время срабатывания аномалии будет рожден артефакт
artefact_spawn_rnd			= 30
