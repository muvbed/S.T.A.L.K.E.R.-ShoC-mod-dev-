;----------- Аномалия Ведьмин студень -----------------------
[zone_buzz]
script_binding      		= ogse_dbg_anomaly_binder.init

GroupControlSection			= spawn_group_zone
$spawn 						= "zones\buzz"
$prefetch 					= 16
class						= ZS_MBALD

bend_grass_blowout 			= true
bend_grass_blowout_speed 	= 3.0
bend_grass_blowout_radius 	= 3.0

hit_impulse_scale			= 0.0
effective_radius			= 1.0 ;размер радиуса в процентах от оригинального, где действует зона

ef_anomaly_type				= 1
ef_weapon_type				= 13

sound						= 
postprocess					= postprocess_ameba
	
artefacts					= af_ameba_slime,0.6, af_ameba_slug,0.3, af_ameba_mica,0.1
BirthProbability 			= 0.1
artefact_spawn_probability 	= 0.1					;вероятность, что во время срабатывания аномалии будет рожден артефакт
artefact_spawn_rnd			= 10

artefact_spawn_particles 	= anomaly2\pux_blast	;партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound 		= anomaly\pux_blast		;звук, который отыграются на месте рождения артефакта (опционально)

throw_out_power 			= 10					;импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height 		= 1						;(м) высота на центром зоны где будет рожден артефакт

;----------- Anomaly settings -----------------------
min_start_power				= 0.6
max_start_power				= 0.9
attenuation					= 1
period						= 1
min_artefact_count			= 0
max_artefact_count			= 1
artefact_spawn_idle			= 24  ;насколько часто спонить артефакты в офлайне, в часах

idle_particles				= zones_mine\zone_acidic_mine_idle
blowout_particles			= zones_mine\zone_acidic_mine_hit

idle_sound					= anomaly\buzz_idle			;постоянный звук
blowout_sound				= anomaly\buzz_hit			;во время выброса(удара) в центре аномалии	
hit_sound					= anomaly\buzz_hit			;на персонаже, когда тот получает хит
entrance_sound				= anomaly\buzz_hit			;при попадании объекта в аномалию

hit_type					= chemical_burn
							  
disable_time				= 10000	;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small			= -1	;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time			= 50000	;время отключения idle партиклов

ignore_nonalive				= false
ignore_small				= false
ignore_artefacts			= false

blowout_light				= on
light_color		    		= 1.1,1.7,1.4
light_animation             = light_green_01
light_range		    		= 5.0
light_time 		    		= 0.35
light_height				= 0.75			;подъем источника света на высоту

idle_light					= off
idle_light_range			= 3.0
idle_light_range_delta 		= 0.25
idle_light_anim				= light_green_02
idle_light_height			= 0.70			;подъем источника света на высоту

awaking_time				= 10
blowout_time				= 200	
accamulate_time				= 500

visible_by_detector 		= on

blowout_wind				= off

blowout_wind_time_start 	= 0
blowout_wind_time_peak  	= 600
blowout_wind_time_end		= 899
blowout_wind_power			= 0.5			;сила поднимаего ветра (от 0 до 1), в момент blowout_wind_time_peak 

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;рождение артефактов во время срабатывания
spawn_blowout_artefacts 	= off

[zone_buzz_weak]:zone_buzz
$spawn 						= "zones\buzz weak"

artefacts					= af_ameba_slime,0.6, af_ameba_slug,0.3, af_ameba_mica,0.1
BirthProbability 			= 0.1
artefact_spawn_probability 	= 0.1
artefact_spawn_rnd			= 10  ;вероятность заспавнить артефакт в процентах.

;----------- Anomaly settings -----------------------
min_start_power				= 0.4
max_start_power				= 0.6

[zone_buzz_average]:zone_buzz
$spawn 						= "zones\buzz average"

artefacts					= af_ameba_slime,0.5, af_ameba_slug,0.3, af_ameba_mica,0.2
BirthProbability 			= 0.2
artefact_spawn_probability 	= 0.2
artefact_spawn_rnd			= 20  ;вероятность заспавнить артефакт в процентах.

;----------- Anomaly settings -----------------------
min_start_power				= 0.6
max_start_power				= 0.9

[zone_buzz_strong]:zone_buzz
$spawn 						= "zones\buzz strong"

artefacts					= af_ameba_slime,0.4, af_ameba_slug,0.3, af_ameba_mica,0.2, af_dummy_pellicle,0.1
BirthProbability 			= 0.3
artefact_spawn_probability 	= 0.3
artefact_spawn_rnd			= 30  ;вероятность заспавнить артефакт в процентах.

;----------- Anomaly settings -----------------------
min_start_power				= 0.8
max_start_power				= 1.2

[noartf_buzz_weak]:zone_buzz_weak
$spawn 						= "zones\buzz_weak_noartf"

[noartf_buzz_average]:zone_buzz_average
$spawn 						= "zones\buzz_average_noart"

[noartf_buzz_strong]:zone_buzz_strong
$spawn 						= "zones\buzz_strong_noartf"
