;----------- Аномалия Электра -----------------------
[zone_witches_galantine]
script_binding      		= ogse_dbg_anomaly_binder.init

GroupControlSection			= spawn_group_zone
$spawn 						= "zones\witches galantine"
$prefetch 					= 16
class						= ZS_MBALD
hit_impulse_scale			= 0.03
effective_radius			= 0.75 					;размер радиуса в процентах от оригинального, где действует зона
sound						= zone_mosquito_bald
postprocess					= postprocess_electra

bend_grass_blowout 			= true
bend_grass_blowout_speed 	= 4.0
bend_grass_blowout_radius 	= 5.0

ef_anomaly_type				= 1
ef_weapon_type				= 13

spawn_blowout_artefacts 	= off

artefacts					= af_electra_sparkler,0.6, af_electra_flash,0.3, af_electra_moonlight,0.1
BirthProbability 			= 0.1
artefact_spawn_probability 	= 0.1					;вероятность, что во время срабатывания аномалии будет рожден артефакт
artefact_spawn_rnd			= 10

artefact_spawn_particles 	= anomaly2\pux_blast	;партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound 		= anomaly\pux_blast		;звук, который отыграются на месте рождения артефакта (опционально)

throw_out_power 			= 10					;импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height 		= 1						;(м) высота на центром зоны где будет рожден артефакт

;----------- Anomaly settings -----------------------
min_start_power				= 0.6
max_start_power				= 1.0
attenuation					= 1
period						= 1
min_artefact_count			= 0
max_artefact_count			= 1
artefact_spawn_idle			= 24  ;насколько часто спонить артефакты в офлайне, в часах

idle_particles				= zones_mine\zone_electric_mine_idle
blowout_particles			= anomaly2\electra2_blast

hit_small_particles			= anomaly2\electra_entrance_small
hit_big_particles			= anomaly2\electra_damage_02_smoke
idle_small_particles		= anomaly2\electra_damage_01_smoke
idle_big_particles			= anomaly2\electra_damage_02_smoke
entrance_small_particles	= anomaly2\electra_entrance_small
entrance_big_particles		= anomaly2\emi_entrance_big_00

idle_sound					= anomaly\electra_idle1
blowout_sound				= anomaly\electra_blast1
hit_sound					= anomaly\electra_hit
entrance_sound				= anomaly\electra_hit

blowout_light				= on
light_color		    		= 0.8,0.9,1.0
light_range		    		= 30.0
light_time 		    		= 1
light_height				= 1.5			;подъем источника света на высоту

idle_light					= off
idle_light_shadow			= false
idle_light_range			= 4.0
idle_light_anim				= koster_01_electra
idle_light_height			= 0.75			;подъем источника света на высоту

hit_type					= shock

disable_time				= 50			;время игнорирования неживого объекта в зоне (-1 если не нужно)
disable_time_small			= 500			;время игнорирования маленького неживого объекта в зоне (-1 если не нужно)
disable_idle_time			= 100			;время отключения idle партиклов

awaking_time				= 100
blowout_time				= 1000	
accamulate_time				= 1000

ignore_nonalive				= false
ignore_small				= false
ignore_artefacts			= true

visible_by_detector 		= on

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
;; ветер
blowout_wind				= off

blowout_wind_time_start     = 0
blowout_wind_time_peak      = 150
blowout_wind_time_end		= 299
blowout_wind_power			= 0.2			;сила поднимаего ветра (от 0 до 1), в момент blowout_wind_time_peak 

shape_transp_color			= 255, 0, 0, 60
shape_edge_color			= 32, 32, 32, 255

[zone_witches_galantine_weak]:zone_witches_galantine
$spawn 						= "zones\witches galantine weak"

;----------- Anomaly settings -----------------------
min_start_power				= 0.3
max_start_power				= 0.5

[zone_witches_galantine_average]:zone_witches_galantine
$spawn 						= "zones\witches galantine average"

artefacts					= af_electra_sparkler,0.5, af_electra_flash,0.3, af_electra_moonlight,0.2
BirthProbability 			= 0.2
artefact_spawn_probability 	= 0.2

;----------- Anomaly settings -----------------------
min_start_power				= 0.6
max_start_power				= 1.0

artefact_spawn_rnd			= 20  ;вероятность заспавнить артефакт в процентах.

[zone_witches_galantine_strong]:zone_witches_galantine
$spawn 						= "zones\witches galantine strong"

artefacts					= af_electra_sparkler,0.4, af_electra_flash,0.3, af_electra_moonlight,0.2, af_dummy_battery,0.1
BirthProbability 			= 0.3
artefact_spawn_probability 	= 0.3

;----------- Anomaly settings -----------------------
min_start_power				= 1.2
max_start_power				= 1.8

artefact_spawn_rnd			= 30  ;вероятность заспавнить артефакт в процентах.

[noartf_witches_galantine_weak]:zone_witches_galantine_weak
$spawn 						= "zones\witches_galantine_weak_noartf"

[noartf_witches_galantine_average]:zone_witches_galantine_average
$spawn 						= "zones\witches_galantine_average_noartf"

[noartf_witches_galantine_strong]:zone_witches_galantine_strong
$spawn 						= "zones\witches_galantine_strong_noartf"
