;----------- Аномалия Жарка -----------------------
[zone_zharka_static]
script_binding      			= ogse_dbg_anomaly_binder.init

GroupControlSection				= spawn_group_zone
$spawn 							= "zones\zharka_statik"
$prefetch 						= 16
class							= ZS_MBALD
hit_impulse_scale				= 0.0
effective_radius				= 1.3 
sound							= zone_mosquito_bald
postprocess						= postprocess_flame

bend_grass_idle_radius 			= 3.5

bend_grass_whenactive_anim 		= 4
bend_grass_whenactive_str 		= 2.0
bend_grass_whenactive_speed 	= 3.5

bend_grass_blowout 				= true
bend_grass_blowout_duration 	= 2500
bend_grass_blowout_speed 		= 3.0
bend_grass_blowout_radius 		= 5.0

ef_anomaly_type					= 1
ef_weapon_type					= 13

spawn_blowout_artefacts 		= off

artefacts						= af_drops,0.6, af_fireball,0.3, af_cristall,0.1
BirthProbability 				= 0.1
artefact_spawn_probability 		= 0.1
artefact_spawn_rnd				= 10  ;вероятность заспавнить артефакт в процентах.

artefact_spawn_particles 		= anomaly2\pux_blast	;партиклы, которые отыграются на месте рождения артефакта (опционально)
artefact_born_sound 			= anomaly\pux_blast		;звук, который отыграются на месте рождения артефакта (опционально)

throw_out_power 				= 10					;импульс с которым артефакт будет выброшен из зоны в произвольном направлении
artefact_spawn_height 			= 1						;(м) высота на центром зоны где будет рожден артефакт

;----------- Anomaly settings -----------------------
min_start_power					= 1.4
max_start_power					= 1.8
attenuation						= 1
period							= 1
min_artefact_count				= 0
max_artefact_count				= 1
artefact_spawn_idle				= 24  ;насколько часто спонить артефакты в офлайне, в часах

idle_particles					= static\buble_distort00 ;_ecp\group_items\anomaly_burner_fog
blowout_particles				= static\zharka_static

hit_small_particles				= damage_fx\burn_creatures
hit_big_particles				= damage_fx\burn_creatures00
idle_small_particles			= damage_fx\burn_creatures
idle_big_particles				= damage_fx\burn_creatures00

idle_particles_dont_stop		= true;

idle_sound						= anomaly\torrid_idle			
blowout_sound					= anomaly\fireball_blow		
hit_sound						= anomaly\fireball_hit								
entrance_sound					= anomaly\fireball_hit									

hit_type						= burn

disable_time					= 10000		
disable_time_small				= -1		
disable_idle_time				= 50000		

ignore_nonalive					= false
ignore_small					= false
ignore_artefacts				= true

blowout_light					= on
light_color		    			= 1.9,1.6,1.3
light_range		    			= 18.0
light_time 		    			= 10
light_height					= 2			

idle_light						= off
idle_light_range				= 8.0
idle_light_range_delta 			= 0.2
idle_light_anim					= koster_01
idle_light_height				= 0.70			

awaking_time					= 100
blowout_time					= 8000	
accamulate_time					= 1000

visible_by_detector 			= on

blowout_wind					= off

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;
spawn_blowout_artefacts 		= off

[zone_zharka_static_weak]:zone_zharka_static
$spawn 							= "zones\zharka_statik_weak"

artefacts						= af_drops,0.6, af_fireball,0.3, af_cristall,0.1
BirthProbability 				= 0.1
artefact_spawn_probability 		= 0.1

;----------- Anomaly settings -----------------------
min_start_power					= 0.7
max_start_power					= 0.9

artefact_spawn_rnd				= 10  ;вероятность заспавнить артефакт в процентах.

[zone_zharka_static_average]:zone_zharka_static
$spawn 							= "zones\zharka_statik_average"

artefacts						= af_drops,0.5, af_fireball,0.3, af_cristall,0.2
BirthProbability 				= 0.2
artefact_spawn_probability 		= 0.2

;----------- Anomaly settings -----------------------
min_start_power					= 1.4
max_start_power					= 1.8

artefact_spawn_rnd				= 20  ;вероятность заспавнить артефакт в процентах.

[zone_zharka_static_strong]:zone_zharka_static
$spawn 							= "zones\zharka_statik_strong"

artefacts						= af_drops,0.4, af_fireball,0.3, af_cristall,0.2, af_dummy_dummy,0.1
BirthProbability 				= 0.3
artefact_spawn_probability 		= 0.3

;----------- Anomaly settings -----------------------
min_start_power					= 2.1
max_start_power					= 2.7

artefact_spawn_rnd				= 30  ;вероятность заспавнить артефакт в процентах.

[noartf_zharka_static_weak]:zone_zharka_static_weak
$spawn 							= "zones\zharka_static_weak_noartf"

[noartf_zharka_static_average]:zone_zharka_static_average
$spawn 							= "zones\zharka_static_average_noartf"

[noartf_zharka_static_strong]:zone_zharka_static_strong
$spawn 							= "zones\zharka_static_strong_noartf"
