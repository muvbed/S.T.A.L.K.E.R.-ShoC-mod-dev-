[logic]
active = sr_idle@idle

[sr_idle@idle]
on_info = {+bar_arena_fight_1 -bar_arena_fight_1_done} sr_idle@wait %=disable_ui%, {+bar_arena_fight_2 -bar_arena_fight_2_done} sr_idle@wait %=disable_ui%, {+bar_arena_fight_3 -bar_arena_fight_3_done} sr_idle@wait %=disable_ui%, {+bar_arena_fight_4 -bar_arena_fight_4_done} sr_idle@wait %=disable_ui%, {+bar_arena_fight_5 -bar_arena_fight_5_done} sr_idle@wait %=disable_ui%, {+bar_arena_fight_6 -bar_arena_fight_6_done} sr_idle@wait %=disable_ui%,  {+bar_arena_fight_8 -bar_arena_fight_8_done} sr_idle@wait %=disable_ui% 

[sr_idle@wait]
on_timer = 500 | sr_idle@fight %+bar_arena_fight_begin =bar_arena_weapon_slot =bar_arena_teleport% 

[sr_idle@fight]
on_info = sr_idle@wait_finish

[sr_idle@wait_finish]
on_info = {+bar_arena_fight_1 +bar_arena_fight_1_done} sr_idle@pause %+bar_arena_fight_1_reward%,{+bar_arena_fight_2 +bar_arena_fight_2_done} sr_idle@pause %+bar_arena_fight_2_reward%,{+bar_arena_fight_3 =bar_arena_fight_3_end} sr_idle@pause %+bar_arena_fight_3_done +bar_arena_fight_3_reward%,{+bar_arena_fight_4 =bar_arena_fight_4_end} sr_idle@pause %+bar_arena_fight_4_done +bar_arena_fight_4_reward%
on_info2 = {+bar_arena_fight_5 =bar_arena_fight_5_end} sr_idle@pause %+bar_arena_fight_5_done +bar_arena_fight_5_reward%, {+bar_arena_fight_6 =bar_arena_fight_6_end} sr_idle@pause %+bar_arena_fight_6_done +bar_arena_fight_6_reward%,{+bar_arena_fight_8 =bar_arena_fight_8_end} nil %+bar_arena_fight_8_done +bar_arena_fight_8_reward%

[sr_idle@pause]
on_info = sr_idle@wait_pause %+bar_arena_pause%

[sr_idle@wait_pause]
on_game_timer = 1 | sr_idle@idle %-bar_arena_pause%