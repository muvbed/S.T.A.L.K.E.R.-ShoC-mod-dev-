[logic]
active = sr_idle@tutorial

[sr_idle@tutorial]
on_info = {+esc_tutorial_start} sr_idle@tutorial_inventory

[sr_idle@tutorial_inventory]
on_info = {+esc_find_railroad_passage_find_stalker -encyclopedy_tutorial_diary} sr_idle@wait_diary_tutor
on_info2 = {+encyclopedy_tutorial_inventory} sr_idle@tutorial_ruck
on_timer = 1000 | sr_idle@wait_inventory_tutor

[sr_idle@tutorial_ruck]
on_info = {+esc_find_railroad_passage_find_stalker -encyclopedy_tutorial_diary} sr_idle@wait_diary_tutor
on_info2 = {+encyclopedy_tutorial_ruck} sr_idle@tutorial_saves
on_timer = 15000 | sr_idle@wait_ruck_tutor

[sr_idle@tutorial_saves]
on_info = {+esc_find_railroad_passage_find_stalker -encyclopedy_tutorial_diary} sr_idle@wait_diary_tutor
on_info2 = {+encyclopedy_tutorial_saves} sr_idle@tutorial_pockets
on_timer = 15000 | sr_idle@wait_saves_tutor

[sr_idle@tutorial_pockets]
on_info = {+esc_find_railroad_passage_find_stalker -encyclopedy_tutorial_diary} sr_idle@wait_diary_tutor
on_info2 = {+encyclopedy_tutorial_pockets} sr_idle@tutorial_relat
on_timer = 15000 | sr_idle@wait_pockets_tutor

[sr_idle@tutorial_relat]
on_info = {+esc_find_railroad_passage_find_stalker -encyclopedy_tutorial_diary} sr_idle@wait_diary_tutor
on_info2 = {+encyclopedy_tutorial_relation} sr_idle@tutorial_diary
on_timer = 15000 | sr_idle@wait_relat_tutor

[sr_idle@tutorial_diary]
on_info = {+esc_find_railroad_passage_find_stalker -encyclopedy_tutorial_diary} sr_idle@wait_diary_tutor
on_info2 = {+encyclopedy_tutorial_diary} nil

;Отыгрыш туториалов
[sr_idle@wait_diary_tutor]
on_info = {=can_send_tutorial} sr_idle@tutorial %+encyclopedy_tutorial_diary =run_tutorial(part_pda_diary)%

[sr_idle@wait_inventory_tutor]
on_info = {=can_send_tutorial} sr_idle@tutorial_ruck %+encyclopedy_tutorial_inventory =run_tutorial(part_5_inventory)%

[sr_idle@wait_ruck_tutor]
on_info = {=can_send_tutorial} sr_idle@tutorial_saves %+encyclopedy_tutorial_ruck =run_tutorial(part_4_ruck)%

[sr_idle@wait_saves_tutor]
on_info = {=can_send_tutorial} sr_idle@tutorial_pockets %+encyclopedy_tutorial_saves =run_tutorial(part_10_saves)%

[sr_idle@wait_pockets_tutor]
on_info = {=can_send_tutorial} sr_idle@tutorial_relat %+encyclopedy_tutorial_pockets =run_tutorial(part_2_pockets)%

[sr_idle@wait_relat_tutor]
on_info = {=can_send_tutorial} sr_idle@tutorial_diary %+encyclopedy_tutorial_relation =run_tutorial(part_12_relations)%