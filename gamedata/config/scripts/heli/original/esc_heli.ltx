[logic]
active = heli_move@idle

[heli_move@idle]
path_move = heli_idle_move
engine_sound = false
combat_use_rocket = false
combat_use_mgun = true
on_info = {+esc_heli_go -blowout} heli_move@fly
on_info2 = {+blowout} heli_move@sleep
on_info3 = {+esc_blockpost_alarm -blowout} heli_move@blockpost_assist
combat_safe_altitude = -80

[heli_move@fly]
path_move = heli_fly
combat_use_rocket = false
combat_use_mgun = true
on_signal = heli_radio| heli_move@fight %+esc_heli_direct%
on_signal2 = fly_end| heli_move@patrol
on_info = {+blowout} heli_move@sleep
on_info2 = {+esc_blockpost_alarm -blowout} heli_move@blockpost_assist
combat_safe_altitude = -80

[heli_move@fight]
path_move = heli_fly
combat_use_rocket = false
combat_use_mgun = true
on_signal = fly_end| heli_move@patrol
on_info = {+blowout} heli_move@sleep
on_info2 = {+esc_heli_fire} heli_move@patrol
combat_safe_altitude = -80

[heli_move@patrol]
path_move = heli_sleep
on_signal = heli_sig| heli_move@sleep
combat_safe_altitude = -80
on_info = {+blowout} heli_move@sleep
invulnerable = true
mute = true

[heli_move@sleep]
path_move = heli_sleep2
on_info = {+esc_blockpost_alarm -blowout} heli_move@blockpost_assist
on_info2 = {=is_heli_time -blowout} heli_move@fly
engine_sound = false
combat_safe_altitude = -80

[heli_move@blockpost_assist]
path_move = esc_heli_blockpost_assist
combat_enemy = area(-157,-250,100,all), area(-157,-350,150,all)
combat_use_rocket = false
combat_use_mgun = true
on_game_timer = 30000 | heli_move@fight
on_info = {+blowout} heli_move@patrol
on_info2 = {+esc_blockpost_normal} heli_move@patrol
on_info3 = {=gulag_empty(esc_blokpost)} heli_move@patrol
combat_safe_altitude = -80
invulnerable = false
mute = false
engine_sound = true
