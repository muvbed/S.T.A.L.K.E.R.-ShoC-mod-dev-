<?xml version='1.0' encoding="UTF-8"?>
<!-- ОКНО ОБЫСКА ТРУПОВ И ТАЙНИКОВ -->
<window>
	<!-- Состояние предмета -->
	<condition_progess_bar x="1" y="1" width="30" height="5" animated="1" horz="1" min="0" max="100" pos="1">
		<min_color color="inv_condition_min"/>
		<middle_color color="inv_condition_mid"/>
		<max_color color="inv_condition_max"/>
		<background>
			<texture x="0" y="908" width="30" height="5" color="inv_condition_base">ui_inv_shk_itembar</texture>
		</background>
		<progress>
			<texture>ui_inv_shk_itembar</texture>
		</progress>
	</condition_progess_bar>

	<!-- Главное окно -->
	<main x="0" y="0" width="1024" height="768">
		<auto_static>
			<texture>ui_trade_wnd</texture>
		</auto_static>
	</main>

	<top_background/>

	<bottom_background x="825" y="736" width="191" height="27">
		<texture>ui_weight_wnd</texture>
	</bottom_background>

	<!-- Иконка ГГ (не используется) -->
	<static_icon x="848" y="11" width="1" height="1"/>

	<!-- Иконка НПС -->
	<static_icon x="341" y="11" width="165" height="108"/>

	<!-- Рюкзак ГГ -->
	<our_bag_static x="518" y="130" width="496" height="600" always_show_scroll="0">
		<text x="395" y="611" font="letterica16" color="white_1" complex_mode="1"/>
		<texture/>
	</our_bag_static>

	<!-- Рюкзак НПС/Тайник -->
	<others_bag_static x="11" y="133" width="496" height="600" always_show_scroll="0">
		<text align="r" x="-181" y="-35" font="arial_14" color="grey_1">st_items</text>
		<texture/>
	</others_bag_static>

	<!-- Сетка рюкзака ГГ -->
	<dragdrop_list_our x="4" y="4" width="488" height="593"
			cell_width="46" cell_height="46" rows_num="12" cols_num="10"
			unlimited="1" group_similar="0" condition_progress_bar="1" 
			always_show_scroll="0"/>

	<!-- Сетка рюкзака НПС/тайника -->
	<dragdrop_list_other x="4" y="1" width="488" height="593"
			cell_width="46" cell_height="46" rows_num="12" cols_num="10"
			unlimited="1" group_similar="0" condition_progress_bar="1" 
			always_show_scroll="0"/>

	<!-- Характеристики ГГ -->
	<actor_chars>
		<!-- иконка -->
		<icon_static x="848" y="11" width="165" height="108" stretch="1"/>
	
		<!-- покрытие -->
		<layer_actor x="847" y="10" width="167" height="110" stretch="1"/>
		<layer_npc x="340" y="10" width="167" height="110" stretch="1"/>
	</actor_chars>

	<!-- Деньги -->
    <money_static x="703" y="99" width="128" height="20">
		<text align="r" font="arial_14" color="white_3" complex_mode="0"/>
    </money_static>

	<!-- Единица массы -->
	<auto_static x="994" y="741" width="220" height="30">
		<text font="letterica16" color="grey_3">st_ui_kg</text>
	</auto_static>

	<frame_window/>
    <descr_static/>

	<!-- Взять все -->	
	<take_all_btn x="211" y="735" width="121" height="29" accel="kX">
		<texture>ui_button_ordinary</texture>
		<sound_t>interface\inv_take</sound_t>
		<text align="c" font="letterica16" color="white_1">ui_st_take_all</text>
    </take_all_btn>

	<!-- Выход -->    
    <exit_button x="513" y="735" width="121" height="29">
		<texture>ui_button_ordinary</texture>
		<text align="c" font="letterica16" color="white_1">ui_inv_exit</text>
    </exit_button>

	<!-- Звуки действий при обыске -->
	<action_sounds>
		<snd_open>$no_sound</snd_open>
		<snd_close>$no_sound</snd_close>
		<snd_properties>interface\inv_properties</snd_properties>
		<snd_drop_item>interface\inv_drop</snd_drop_item>
		<snd_attach_addon>interface\inv_attach_addon</snd_attach_addon>
		<snd_detach_addon>interface\inv_detach_addon</snd_detach_addon>
		<snd_item_use>interface\inv_slot</snd_item_use>
		<snd_unload_wpn>interface\inv_unload_ammo</snd_unload_wpn>
	</action_sounds>
</window>