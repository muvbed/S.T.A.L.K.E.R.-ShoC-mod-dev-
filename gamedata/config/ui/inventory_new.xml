<?xml version='1.0' encoding="UTF-8"?>
<!-- ИНВЕНТАРЬ -->
<w>
	<!-- Состояние предмета -->
	<condition_progess_bar x="1" y="1" width="30" height="5" animated="1" horz="1" min="0" max="100" pos="1">
		<min_color color="inv_condition_min"/>
		<middle_color color="inv_condition_mid"/>
		<max_color color="inv_condition_max"/>
		<background>
			<texture x="0" y="908" width="30" height="5" color="inv_condition_base">ui_inv_shk_itembar</texture>
		</background>
		<progress>
			<texture>ui_inv_shk_itembar</texture>
		</progress>
	</condition_progess_bar>

	<!-- Состояние костюма -->
	<condition_outfit_progress x="30" y="444" width="58" height="5" animated="1" horz="1" min="0" max="100" pos="100">
		<min_color color="inv_condition_min"/>
		<middle_color color="inv_condition_mid"/>
		<max_color color="inv_condition_max"/>
		<progress>
			<texture>ui_inv_shk_itembar</texture>
		</progress>
    </condition_outfit_progress>

	<!-- Состояние оружия 1 слота -->
    <condition_weapon1_progress x="157" y="556" width="58" height="5" animated="1" horz="1" min="0" max="100" pos="100">
		<min_color color="inv_condition_min"/>
		<middle_color color="inv_condition_mid"/>
		<max_color color="inv_condition_max"/>
		<progress>
			<texture>ui_inv_shk_itembar</texture>
		</progress>
    </condition_weapon1_progress>

	<!-- Состояние оружия 2 слота -->
    <condition_weapon2_progress x="157" y="668" width="58" height="5" animated="1" horz="1" min="0" max="100" pos="100">
		<min_color color="inv_condition_min"/>
		<middle_color color="inv_condition_mid"/>
		<max_color color="inv_condition_max"/>
		<progress>
			<texture>ui_inv_shk_itembar</texture>
		</progress>
    </condition_weapon2_progress>

	<!-- Счетчик предметов -->
	<cell_item_text x="0" y="0" width="30" height="14" stretch="1">
		<texture a="180">ui_fast_use_count_back</texture>
		<text x="-1" y="-1" width="30" height="16" font="letterica16" color="white_4" align="c" vert_align="t"/>
	</cell_item_text>

	<!-- Контекстное меню -->
	<properties_box>
		<texture>ui_cb_listbox</texture>
		<list x="0" y="0" width="10" height="10" item_height="18"  always_show_scroll="0" can_select="1" bottom_indent="10" right_ident="10" left_ident="20">
			<font_s color="white_2"/>
			<font color="grey_2" font="letterica16"/>
		</list>
	</properties_box>

	<!-- Главное окно -->
	<main x="0" y="0" width="1024" height="768"/>
    
    <!-- Быстрый сброс -->
    <static_ruck x="52" y="120" width="75" height="93.8" stretch="1">
    	<texture x="0" y="0" width="100" height="125">ui\ruck_static</texture>
    </static_ruck>

	<back x="0" y="0" width="1024" height="768">
		<texture>ui_inventory_main</texture>
	</back>

	<!-- Деньги ГГ -->
    <money_static x="55" y="666" width="119" height="46">
		<text align="r" y="16" font="arial_14" color="white_3" complex_mode="0"/>
    </money_static>

	<!-- Рюкзак -->
    <dragdrop_bag x="7" y="56" width="634" height="581"
			cell_width="46" cell_height="46" rows_num="12" cols_num="13"
			unlimited="1" group_similar="0" condition_progress_bar="1" 
			always_show_scroll="0" a="0" />

	<!-- Слот костюма -->
    <dragdrop_outfit x="200" y="128" width="138" height="184" custom_placement="0"
            cell_width="46" cell_height="46" rows_num="4" cols_num="3"
            virtual_cells="1" vc_vert_align="c" vc_horiz_align="c"
			condition_progress_bar="0" a="0" />

	<!-- Слот пистолета -->
    <dragdrop_pistol x="23" y="395" width="322" height="92" custom_placement="0"
            cell_width="46" cell_height="46" rows_num="2" cols_num="7"
            virtual_cells="1" vc_vert_align="c" vc_horiz_align="c"
			condition_progress_bar="0" a="0" />

	<!-- Слот автомата -->
    <dragdrop_automatic x="23" y="548" width="322" height="92" custom_placement="0"
            cell_width="46" cell_height="46" rows_num="2" cols_num="7"
            virtual_cells="1" vc_vert_align="c" vc_horiz_align="c"
			condition_progress_bar="0" a="0" />

	<!-- Пояс -->
	<dragdrop_belt x="372" y="17" width="644" height="46"
            cell_width="46" cell_height="46" rows_num="1" cols_num="14"/>

	<!-- Слоты OGSE -->
	<dragdrop_knife x="254" y="17" width="92" height="46" custom_placement="0"
            cell_width="46" cell_height="46" rows_num="1" cols_num="2"
			virtual_cells="1" vc_vert_align="c" vc_horiz_align="c" a="0"/>
	<dragdrop_binocular x="-4" y="266" width="184" height="92" custom_placement="0"
            cell_width="46" cell_height="46" rows_num="2" cols_num="4"
			virtual_cells="1" vc_vert_align="c" vc_horiz_align="c" a="0"/>
	<dragdrop_torch x="99999" y="681" width="92" height="46" custom_placement="0"
            cell_width="46" cell_height="46" rows_num="1" cols_num="2"
			virtual_cells="1" vc_vert_align="c" vc_horiz_align="c" a="0"/>
	<dragdrop_helmet x="99999" y="186" width="92" height="92" custom_placement="0"
            cell_width="46" cell_height="46" rows_num="2" cols_num="2"
			virtual_cells="1" vc_vert_align="c" vc_horiz_align="c" a="0"/>
		
	<!-- Слоты OGSE, переделанные под быстрый доступ -->	
	<dragdrop_detector x="381" y="692" width="46" height="46" custom_placement="0"
            cell_width="46" cell_height="46" rows_num="1" cols_num="1"
			virtual_cells="1" vc_vert_align="c" vc_horiz_align="c" a="0"/>
	<dragdrop_nv x="448" y="692" width="46" height="46" custom_placement="0"
            cell_width="46" cell_height="46" rows_num="1" cols_num="1"
			virtual_cells="1" vc_vert_align="c" vc_horiz_align="c" a="0"/>
	<dragdrop_biodetector x="515" y="692" width="46" height="46" custom_placement="0"
            cell_width="46" cell_height="46" rows_num="1" cols_num="1"
