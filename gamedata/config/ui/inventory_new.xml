	<outfit_info x="0" y="0" width="0" height="0">
		<scroll_view x="0" y="0" width="0" height="0"
		always_show_scroll="0" scroll_profile="pda"/>
	</outfit_info>

	<static_personal/>

	<!-- Шкала здоровья -->
    <progress_bar_health x="14" y="46" width="214" height="15" horz="1" min="0" max="100" pos="0">
		<progress>
			<texture color="red">ui_inv_shk_healthbar</texture>
		</progress>
    </progress_bar_health>

	<!-- Шкала пси-здоровья -->
    <progress_bar_psy/>

	<!-- Шкала радиационного заражения -->
	<progress_bar_radiation/>

	<!-- Шкала опыта -->
    <progress_bar_rank/>

	<!-- Фон для текстур состояния -->
    <progress_background/>

	<!-- Тектура фона опыта (МП) -->
    <progress_back_rank/>

	<!-- Теустура фона и иконки уровня (МП) -->
    <rank x="277" y="10" width="75" height="65">
		<texture>ui_inventory_rank</texture>
		<pic x="14" y="17" width="46" height="47"/>
    </rank>

	<!-- Вес -->
	<bag_static x="369" y="25" width="645" height="692" complex_mode="1">
      	<text x="482" y="656" font="letterica16" color="grey_3" complex_mode="1"/>
    </bag_static>

	<!-- "Время" -->
    <time_static x="751" y="99999" width="200" height="30">
        <text font="letterica16" color="grey_3">ui_inv_time</text>
	</time_static>

	<!-- Часы -->
    <time_static_str x="-34" y="99999" width="107" height="30">
         <text align="r" font="letterica16" color="white_3"/>
	</time_static_str>

	<!-- Окно описания -->
    <descr_static/>

	<!-- "Костюм" -->
    <character_frame_window/>

	<bottom_static/>
	<belt_slots/>

	<!-- Выход -->
    <exit_button x="867" y="715" width="121" height="29">
		<texture>ui_button_ordinary</texture>
		<text align="c" font="letterica16" color="white_1">ui_inv_exit</text>
    </exit_button>

