	<dragdrop_belt x="407.5" y="17" width="481.6" height="46"
            cell_width="34.4" cell_height="46" rows_num="1" cols_num="14"/>

	<!-- Слоты OGSE -->
	<dragdrop_knife x="318" y="17" width="68.8" height="46" custom_placement="0"
            cell_width="34.4" cell_height="46" rows_num="1" cols_num="2"
			virtual_cells="1" vc_vert_align="c" vc_horiz_align="c" a="0"/>
	<dragdrop_binocular x="163" y="266" width="68.8" height="92" custom_placement="0"
            cell_width="34.4" cell_height="46" rows_num="2" cols_num="2"
			virtual_cells="1" vc_vert_align="c" vc_horiz_align="c" a="0"/>
	<dragdrop_torch x="99999" y="681" width="68.8" height="46" custom_placement="0"
