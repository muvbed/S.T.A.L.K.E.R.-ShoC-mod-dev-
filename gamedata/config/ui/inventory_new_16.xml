			virtual_cells="1" vc_vert_align="c" vc_horiz_align="c" a="0"/>
	<dragdrop_helmet x="99999" y="186" width="68.8" height="92" custom_placement="0"
            cell_width="34.4" cell_height="46" rows_num="2" cols_num="2"
			virtual_cells="1" vc_vert_align="c" vc_horiz_align="c" a="0"/>
			
	<!-- Слоты OGSE, переделанные под быстрый доступ -->
	<dragdrop_detector x="414" y="692" width="34.4" height="46" custom_placement="0"
            cell_width="34.4" cell_height="46" rows_num="1" cols_num="1"
			virtual_cells="1" vc_vert_align="c" vc_horiz_align="c" a="0"/>
	<dragdrop_nv x="464" y="692" width="34.4" height="46" custom_placement="0"
