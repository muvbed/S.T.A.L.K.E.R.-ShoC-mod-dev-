[wpn_glock17_hud]:hud_base
zoom_hide_crosshair			= true

hands_position				= 0.0,-0.13,0.03
hands_orientation			= 0.0,0.0,0.0
hands_position_16x9			= 0.0,-0.13,0.03
hands_orientation_16x9			= 0.0,0.0,0.0

aim_hud_offset_pos = 0.0,0.031,0.0
aim_hud_offset_rot = -0.005,0.0,0.0

aim_hud_offset_pos_16x9 = 0.0,0.031,0.0
aim_hud_offset_rot_16x9 = -0.005,0.0,0.0

item_position			= 0.0,0.0,0.0
item_orientation		= 0.0,0.0,0.0

item_visual             	= dynamics\weapons\wpn_glock17\wpn_glock17_hud.ogf
attach_place_idx		= 0

shell_point			= 0.0,-9.0,0.0
shell_bone              	= wpn_body

fire_point			= -0.010,0.10,0.37
fire_bone               	= wpn_body


disable_bore = true                                            ;отключение анимации скуки
mix_shoot_after_idle = true                                    ;микс первого выстрела с анимациями idle
mix_shoot_after_shoot_in_queue = true                          ;микс между серией выстрелов

;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;

;Доставание///////////////////////////////////////////////////
anm_show                   = glock17_draw
anm_show_empty             = glock17_draw, idle_empty
anm_show_jammed            = glock17_draw, idle_jammed

;Убирание/////////////////////////////////////////////////////
anm_hide                   = glock17_hide
anm_hide_empty             = glock17_hide, idle_empty
anm_hide_jammed            = glock17_hide, idle_jammed

;Бездействие//////////////////////////////////////////////////
anm_idle                            = glock17_idle
anm_idle_empty                      = glock17_idle, idle_empty
anm_idle_jammed                     = glock17_idle, idle_jammed
anm_idle_w_gl                       = glock17_idle
anm_idle_empty_w_gl                 = glock17_idle, idle_empty
anm_idle_jammed_w_gl                = glock17_idle
anm_idle_g                          = glock17_idle
anm_idle_empty_g                    = glock17_idle, idle_empty
anm_idle_jammed_g                   = glock17_idle
anm_idle_slow                       = glock17_idle
anm_idle_crouch                    = glock17_idle
anm_idle_crouch_slow               = glock17_idle
anm_idle_slow_empty                 = glock17_idle, idle_empty
anm_idle_crouch_empty              = glock17_idle, idle_empty
anm_idle_crouch_slow_empty         = glock17_idle, idle_empty
anm_idle_slow_jammed                = glock17_idle, idle_jammed
anm_idle_crouch_jammed             = glock17_idle, idle_jammed
anm_idle_crouch_slow_jammed        = glock17_idle, idle_jammed

;Бездействие в прицеливании///////////////////////////////////
autoshoot_anm_idle_aim_start = true         ;команда заставляет произвести выстрел с задержкой на lock_time, если кнопка выстрела будет нажата раньше заданного времени в lock_time
lock_time_anm_idle_aim_start = 0.2          ;команда блокирует все действия (кроме выбрасывания оружия) во время отыгрывания обозначенной анимации до окончания заданного времени
autoshoot_anm_idle_aim_start_empty = true
lock_time_anm_idle_aim_start_empty = 0.2
autoshoot_anm_idle_aim_start_jammed = true
lock_time_anm_idle_aim_start_jammed = 0.2
anm_idle_aim_start             = glock17_aim_start
anm_idle_aim_start_empty       = glock17_aim_start, idle_empty
anm_idle_aim_start_jammed      = glock17_aim_start, idle_jammed

anm_idle_aim                   = glock17_aim
anm_idle_aim_empty             = glock17_aim, idle_empty
anm_idle_aim_jammed            = glock17_aim, idle_jammed

autoshoot_anm_idle_aim_end = true
lock_time_anm_idle_aim_end = 0.25
autoshoot_anm_idle_aim_end_empty = true
lock_time_anm_idle_aim_end_empty = 0.25
autoshoot_anm_idle_aim_end_jammed = true
lock_time_anm_idle_aim_end_jammed = 0.25
anm_idle_aim_end               = glock17_aim_end
anm_idle_aim_end_empty         = glock17_aim_end, idle_empty
anm_idle_aim_end_jammed        = glock17_aim_end, idle_jammed

;enable_directions_anm_idle = true
enable_directions_anm_idle_aim = true    ;подключение анимаций ходьбы в разных направлениях для обозначенного режима.

;Ходьба ВПЕРЕД//////////////////////////////////////////////////////////////////////////
anm_idle_moving 					= glock17_walk
anm_idle_moving_jammed 					= glock17_walk, idle_jammed
anm_idle_moving_empty					= glock17_walk, idle_empty

;Ходьба медленная (SHIFT) ВПЕРЕД//////////////////////////////////////////////////////////////////////////
anm_idle_moving_slow 					= glock17_slow
anm_idle_moving_slow_jammed 				= glock17_slow, idle_jammed
anm_idle_moving_slow_empty				= glock17_slow, idle_empty

;Ходьба в полуприсяди (CTRL) ВПЕРЕД//////////////////////////////////////////////////////////////////////////
anm_idle_moving_crouch 					= glock17_slow_down
anm_idle_moving_crouch_jammed 					= glock17_slow_down, idle_jammed
anm_idle_moving_crouch_empty					= glock17_slow_down, idle_empty

;Ходьба в присяде (CTRL+SHIFT) ВПЕРЕД/////////////////////////////////////////////////////////////////////////
anm_idle_moving_crouch_slow 					= glock17_slow_super
anm_idle_moving_crouch_slow_jammed 				= glock17_slow_super, idle_jammed
anm_idle_moving_crouch_slow_empty				= glock17_slow_super, idle_empty

;ходьба в прицеливании ВПЕРЕД//////////////////////////////////////////////////////////////////
anm_idle_aim_moving_forward                   = glock17_slow_aim
anm_idle_aim_moving_forward_empty             = glock17_slow_aim, idle_empty
anm_idle_aim_moving_forward_jammed            = glock17_slow_aim, idle_jammed

;ходьба в прицеливании НАЗАД//////////////////////////////////////////////////////////////////
anm_idle_aim_moving_back                   = glock17_slow_aim_back
anm_idle_aim_moving_back_empty             = glock17_slow_aim_back, idle_empty
anm_idle_aim_moving_back_jammed            = glock17_slow_aim_back, idle_jammed

;ходьба в прицеливании ВЛЕВО//////////////////////////////////////////////////////////////////
anm_idle_aim_moving_left                   = glock17_slow_aim_left  
anm_idle_aim_moving_left_empty             = glock17_slow_aim_left  , idle_empty
anm_idle_aim_moving_left_jammed            = glock17_slow_aim_left  , idle_jammed

;ходьба в прицеливании ВПРАВО//////////////////////////////////////////////////////////////////
anm_idle_aim_moving_right                   = glock17_slow_aim_right 
anm_idle_aim_moving_right_empty             = glock17_slow_aim_right , idle_empty
anm_idle_aim_moving_right_jammed            = glock17_slow_aim_right , idle_jammed 

;ходьба в прицеливании ВПЕРЕД+ВЛЕВО////////////////////////////////////////////////////////////
anm_idle_aim_moving_forward_left                   = glock17_slow_aim_left
anm_idle_aim_moving_forward_left_empty             = glock17_slow_aim_left, idle_empty
anm_idle_aim_moving_forward_left_jammed            = glock17_slow_aim_left, idle_jammed

;ходьба в прицеливании ВПЕРЕД+ВПРАВО///////////////////////////////////////////////////////////
anm_idle_aim_moving_forward_right                   = glock17_slow_aim_right
anm_idle_aim_moving_forward_right_empty             = glock17_slow_aim_right, idle_empty
anm_idle_aim_moving_forward_right_jammed            = glock17_slow_aim_right, idle_jammed

;ходьба в прицеливании НАЗАД+ВЛЕВО/////////////////////////////////////////////////////////////
anm_idle_aim_moving_back_left                   = glock17_slow_aim_left
anm_idle_aim_moving_back_left_empty             = glock17_slow_aim_left, idle_empty
anm_idle_aim_moving_back_left_jammed            = glock17_slow_aim_left, idle_jammed

;ходьба в прицеливании НАЗАД+ВПРАВО////////////////////////////////////////////////////////////
anm_idle_aim_moving_back_right                   = glock17_slow_aim_right
anm_idle_aim_moving_back_right_empty             = glock17_slow_aim_right, idle_empty
anm_idle_aim_moving_back_right_jammed            = glock17_slow_aim_right, idle_jammed


;Бег//////////////////////////////////////////////////////////////////
lock_time_anm_idle_sprint_start = 0.15
lock_time_anm_idle_sprint_start_empty = 0.15
lock_time_anm_idle_sprint_start_jammed = 0.15
anm_idle_sprint_start             = glock17_sprint_start
anm_idle_sprint_start_empty       = glock17_sprint_start, idle_empty
anm_idle_sprint_start_jammed      = glock17_sprint_start, idle_jammed

anm_idle_sprint                   = glock17_sprint
anm_idle_sprint_empty             = glock17_sprint, idle_empty
anm_idle_sprint_jammed            = glock17_sprint, idle_jammed

lock_time_anm_idle_sprint_end        = 0.4
lock_time_anm_idle_sprint_end_empty  = 0.4
lock_time_anm_idle_sprint_end_jammed = 0.4
anm_idle_sprint_end             = glock17_sprint_end
anm_idle_sprint_end_empty       = glock17_sprint_end, idle_empty
anm_idle_sprint_end_jammed      = glock17_sprint_end, idle_jammed


;Скука////////////////////////////////////////////////////////////////////
anm_bore                   = glock17_bore
anm_bore_empty             = glock17_bore, idle_empty
anm_bore_jammed            = glock17_bore, idle_jammed

;Выстрелы обычными патронами/////////////////////////////////////////////////////////////////////
anm_shoot                = glock17_shoot
anm_shoot_sil            = glock17_shoot
anm_shoot_jammed	 = glock17_shoot, idle_jammed
anm_shoot_jammed_sil	 = glock17_shoot, idle_jammed
anm_shoot_last           = glock17_shoot_empty
anm_shoot_last_sil       = glock17_shoot_empty
anm_shoot_aim            = glock17_shoot_aim
anm_shoot_aim_sil        = glock17_shoot_aim
anm_shoot_aim_jammed	 = glock17_shoot_aim, idle_jammed
anm_shoot_aim_jammed_sil = glock17_shoot_aim, idle_jammed
anm_shoot_aim_last       = glock17_shoot_aim_empty
anm_shoot_aim_last_sil   = glock17_shoot_aim_empty

;Осечка//////////////////////////////////////////////////
lock_time_anm_fakeshoot_empty = 0.20
anm_fakeshoot_empty      = glock17_dry_empty, idle_empty
lock_time_anm_fakeshoot_aim_empty = 0.20
anm_fakeshoot_aim_empty      = glock17_dry_aim, idle_empty
lock_time_anm_fakeshoot_jammed = 1.0
anm_fakeshoot_jammed     = glock17_dry, idle_jammed
lock_time_anm_fakeshoot_aim_jammed = 0.20
anm_fakeshoot_aim_jammed     = glock17_dry_aim, idle_jammed

;Перезарядка/////////////////////////////////////////////////////////////////////
anm_reload                           = glock17_reload
anm_reload_empty                     = glock17_reload_full
anm_reload_jammed                    = glock17_revival
anm_reload_jammed_last               = glock17_revival_last
anm_reload_ammochange                = glock17_reload
anm_reload_empty_ammochange          = glock17_reload_full

;Смена режима огня//////////////////////////////////////////////////////////////////////////
use_firemode_change_anim = true

;1-a
lock_time_anm_changefiremode_from_1_to_a = 1.1
anm_changefiremode_from_1_to_a			     = glock17_firemode_a_to_1
lock_time_anm_changefiremode_from_1_to_a_jammed = 1.1
anm_changefiremode_from_1_to_a_jammed		     = glock17_firemode_1_to_a, idle_jammed
lock_time_anm_changefiremode_from_1_to_a_empty = 1.53
anm_changefiremode_from_1_to_a_empty		     = glock17_firemode_1_to_a_empty, idle_empty

;1-3
lock_time_anm_changefiremode_from_1_to_3 = 1.1
anm_changefiremode_from_1_to_3			     = glock17_firemode_1_to_a
lock_time_anm_changefiremode_from_1_to_3_jammed = 1.1
anm_changefiremode_from_1_to_3_jammed		     = glock17_firemode_1_to_a, glock17_firemode_1_to_a_jammed
lock_time_anm_changefiremode_from_1_to_3_empty = 1.53
anm_changefiremode_from_1_to_3_empty		     = glock17_firemode_1_to_a_empty

;a-1
lock_time_anm_changefiremode_from_a_to_1 = 1.1
anm_changefiremode_from_a_to_1			     = glock17_firemode_a_to_1
lock_time_anm_changefiremode_from_a_to_1_jammed = 1.1
anm_changefiremode_from_a_to_1_jammed		     = glock17_firemode_a_to_1, glock17_firemode_a_to_1_jammed
lock_time_anm_changefiremode_from_a_to_1_empty = 1.53
anm_changefiremode_from_a_to_1_empty		     = glock17_firemode_a_to_1_empty

;3-1
lock_time_anm_changefiremode_from_3_to_1 = 1.1
anm_changefiremode_from_3_to_1			     = glock17_firemode_a_to_1
lock_time_anm_changefiremode_from_3_to_1_jammed = 1.1
anm_changefiremode_from_3_to_1_jammed		     = glock17_firemode_a_to_1, glock17_firemode_a_to_1_jammed
lock_time_anm_changefiremode_from_3_to_1_empty = 1.53
anm_changefiremode_from_3_to_1_empty		     = glock17_firemode_a_to_1_empty

;Разрядка//////////////////////////////////////////////////////////////////////////
use_unloadmag_anim = true
lock_time_anm_unload_mag = 0.8
anm_unload_mag                               = glock17_draw, idle_empty
lock_time_anm_unload_mag_jammed = 0.8
anm_unload_mag_jammed                        = glock17_draw, idle_jammed    
lock_time_anm_unload_mag_empty = 0.8
anm_unload_mag_empty                         = glock17_draw, idle_empty

;включение налобника//////////////////////////////////////////////////////////////////////////
anm_headlamp_on = glock17_headflash
lock_time_start_anm_headlamp_on = 0.58
lock_time_end_anm_headlamp_on = 0.5

anm_headlamp_on_empty = glock17_headflash, idle_empty
lock_time_start_anm_headlamp_on_empty = 0.58
lock_time_end_anm_headlamp_on_empty = 0.5

anm_headlamp_on_jammed = glock17_headflash, idle_jammed
lock_time_start_anm_headlamp_on_jammed = 0.58
lock_time_end_anm_headlamp_on_jammed = 0.5


;выключение налобника//////////////////////////////////////////////////////////////////////////
anm_headlamp_off = glock17_headflash
lock_time_start_anm_headlamp_off = 0.58
lock_time_end_anm_headlamp_off = 0.5

anm_headlamp_off_empty = glock17_headflash, idle_empty
lock_time_start_anm_headlamp_off_empty = 0.58
lock_time_end_anm_headlamp_off_empty = 0.5

anm_headlamp_off_jammed = glock17_headflash, idle_jammed
lock_time_start_anm_headlamp_off_jammed = 0.58
lock_time_end_anm_headlamp_off_jammed = 0.5


;включение пнв//////////////////////////////////////////////////////////////////////////
anm_nv_on = glock17_nv_on
anm_nv_on_empty = glock17_nv_on, idle_empty
anm_nv_on_jammed = glock17_nv_on, idle_jammed


;выключение пнв//////////////////////////////////////////////////////////////////////////
anm_nv_off = glock17_nv_off
anm_nv_off_empty = glock17_nv_off, idle_empty
anm_nv_off_jammed = glock17_nv_off, idle_jammed
