$prefetch 					= 8
scheduled            		= off              ; option for ALife Simulator
cform                    	= skeleton
class                    	= WP_USP45
min_radius               	= 0
max_radius                  = 30
description          	= gunsl_wpn_usp_descr
ef_weapon_type				= 5
default_to_ruck 			= false

;-----------------------------------------------------------------------------------
