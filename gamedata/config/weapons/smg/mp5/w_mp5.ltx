snd_unload_mag          = $silent
snd_jam                 = $silent
snd_breechblock         = $silent
snd_fakeshoot_first	= weapons\glock17\glock17_shoot_s
snd_fire_modes	= weapons\l85\l85_firemode
;snd_fire_modes_empty
;snd_fire_modes_jammed
snd_aim_start           = weapons\aimin\aim_in_4, 0.3
snd_aim_end             = weapons\aimout\aim_out_4, 0.3
snd_laser_on	        = weapons\l85\l85_lam
