;-----------------------------------------------------------------------------------

hidden_bones = scope5, stock_plastic, stock_short, grip_handler, grip_sd, grip_rail, flash_sd, laser_sd, flash, laser, grip_sd_rail, mag40, mag30_sd, scope1, scope2, scope3, scope4, sight
silencer_bone = wpn_silencer

