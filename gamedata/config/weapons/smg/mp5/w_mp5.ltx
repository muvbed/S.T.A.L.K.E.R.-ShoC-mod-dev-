snd_torch_on	        = weapons\l85\l85_lam
snd_torch_off	        = weapons\l85\l85_lam
snd_headlamp_on         = weapons\headflash_on
snd_headlamp_off        = weapons\headflash_off
snd_nv_on               = weapons\nv_act
snd_nv_off              = weapons\nv_deact

snd_scope_brightness_plus = weapons\nv_intensity
