scope_names             = wpn_addon_scope_eotech, wpn_addon_scope_elcan
scope_x                 = 100
scope_y                 = 100

scope_respawn                                        = wpn_mp5
scope_respawn_wpn_addon_scope_eotech                 = wpn_mp5_eotech
scope_respawn_wpn_addon_scope_elcan                  = wpn_mp5_elcan

silencer_name  				= wpn_silencer_919
silencer_x              = 100           ; offset in inventory icon
silencer_y              = 100

;silencer_flame_particles 	= weapons\generic_weapon01
silencer_smoke_particles 	= weapons\generic_shoot_00

snd_silncer_shot			= weapons\w_ak74_shot1 

