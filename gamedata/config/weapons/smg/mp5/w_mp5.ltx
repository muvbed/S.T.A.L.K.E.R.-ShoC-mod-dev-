kill_msg_height		= 23

slot 					= 2		; // secondary
animation_slot			= 2		; type of the animation that will be used

;-----------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base		= 0.15;0.33 	;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
control_inertion_factor		= 1.07f

;отдача
cam_return			 = 0
