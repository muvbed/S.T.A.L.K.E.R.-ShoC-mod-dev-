cam_dispersion_frac		= 0.99	;ствол будет подыматься на cam_dispersion*cam_dispersion_frac +- cam_dispersion*(1-cam_dispersion_frac)
cam_max_angle           = 90.0   ;максимальный угол отдачи
cam_max_angle_horz		= 3.0	;(degree) maximum shot horizontal degree
cam_step_angle_horz     = 2.5 ;(degree) size of step camera moved in horizontal position while shooting


PDM_disp_base 			= 1.5
PDM_disp_vel_factor 	= 6.0
PDM_disp_accel_factor 	= 8.0
PDM_disp_crouch	 		= 0.9
PDM_disp_crouch_no_acc 	= 0.8

zoom_cam_relax_speed        = 9.0    ; scope & ironsight
zoom_cam_relax_speed_ai     = 120.75
zoom_cam_dispersion         = 2.25
zoom_cam_dispersion_inc     = 1.5
zoom_cam_dispersion_frac    = 0.99
zoom_cam_max_angle          = 70
zoom_cam_max_angle_horz     = 15.0
zoom_cam_step_angle_horz    = 0.5

fire_dispersion_condition_factor = 5	;увеличение дисперсии в процентах при максимальном износе 
misfire_probability 	= 0.005	;вероятность осечки при максимальном износе 
misfire_condition_k		= 0.05
condition_shot_dec 		= 0.0002 ;увеличение износа при каждом выстреле
;-----------------------------------------------------------------------------------

hand_dependence 		= 1
single_handed			= 0

slot 			 		= 2		; // secondary
animation_slot			= 2		; type of the animation that will be used

inv_name                = gunsl_wpn_svu
