sprint_allowed			= true
;-----------------------------------------------------------------------------------
;базовая дисперсия
fire_dispersion_base		= 0.03	;угол (в градусах) базовой дисперсии оружия (оружия зажатого в тисках)
control_inertion_factor		= 1.6f

;отдача
cam_return		= 1
cam_relax_speed         = 12.0  ;скорость возврата в исходное положение
cam_relax_speed_ai      = 360	;скорость возврата в исходное положение
