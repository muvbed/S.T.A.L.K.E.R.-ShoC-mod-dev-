class "evaluator_anomaly" (property_evaluator)

function evaluator_anomaly:__init(storage, npc, name) 
    super(nil, name)
    self.st = storage
    self.npc = npc
    self.called = false
    self.mgr = nil
end

local holdtime = {}
local stucktime = {}
local laststate = {}
local rdelta = {}

function vec2str(v)
    if v and v.x and v.y and v.z then
        return v.x .. ";" .. v.y .. ";" .. v.z
    else
        return "not a vector"
    end
end

-- Спокойное состояние
local error_prob = {
    novice = {
        [clsid.zone_bfuzz_s] = 0,
        [clsid.zone_galant_s] = 0,
        [clsid.zone_mbald_s] = 0,
        [clsid.zone_mincer_s] = 0
    },
    experienced = {
        [clsid.zone_bfuzz_s] = 0,
        [clsid.zone_galant_s] = 0,
        [clsid.zone_mbald_s] = 0,
        [clsid.zone_mincer_s] = 0
    },
    veteran = {
        [clsid.zone_bfuzz_s] = 0,
        [clsid.zone_galant_s] = 0,
        [clsid.zone_mbald_s] = 0,
        [clsid.zone_mincer_s] = 0
    },
    master = {
        [clsid.zone_bfuzz_s] = 0,
        [clsid.zone_galant_s] = 0,
        [clsid.zone_mbald_s] = 0,
        [clsid.zone_mincer_s] = 0
    }
}

-- Бой
local error_prob_fight = {
    novice = {
        [clsid.zone_bfuzz_s] = 40,
        [clsid.zone_galant_s] = 40,
        [clsid.zone_mbald_s] = 40,
        [clsid.zone_mincer_s] = 40
    },
    experienced = {
        [clsid.zone_bfuzz_s] = 20,
        [clsid.zone_galant_s] = 20,
        [clsid.zone_mbald_s] = 20,
        [clsid.zone_mincer_s] = 20
    },
    veteran = {
        [clsid.zone_bfuzz_s] = 10,
        [clsid.zone_galant_s] = 10,
        [clsid.zone_mbald_s] = 10,
        [clsid.zone_mincer_s] = 10
    },
    master = {
        [clsid.zone_bfuzz_s] = 5,
        [clsid.zone_galant_s] = 5,
        [clsid.zone_mbald_s] = 5,
        [clsid.zone_mincer_s] = 5
    }
}

function evaluator_anomaly:evaluate()
    local nid = self.npc:id()
    
    -- Инициализация таблиц для этого NPC
    if laststate[nid] == nil then laststate[nid] = false end
    if stucktime[nid] == nil then stucktime[nid] = {} end
    if rdelta[nid] == nil then rdelta[nid] = {} end
    
    if self.mgr == nil then
        self.mgr = self.object:motivation_action_manager()
    end
    
    -- Проверка раненого состояния
    local wounded_evaluator = self.mgr:evaluator(xr_evaluators_id.sidor_wounded_base)
    if wounded_evaluator and wounded_evaluator:evaluate() then
        return false
    end
    
    if string.find(self.npc:character_community() or "", "zombied") then
        return false
    end

    local error_tbl = self.mgr:evaluator(stalker_ids.property_enemy):evaluate() and error_prob_fight or error_prob

    if holdtime[nid] == nil or time_global() > holdtime[nid] then
        holdtime[nid] = time_global() + 500
        
        local hasanom, anomid, pos, cls, dist, radius = anomaly_holder.get_nearest_anomaly(self.npc)
        local visradius = radius or 0
        
        -- Если сталкер уже видел аномалию, увеличим радиус обнаружения
        if hasanom and anomid and ogse_anomaly.get_anomaly_mode(nil, anomid) ~= "anom_off" then
            if rdelta[nid][anomid] == nil then
                rdelta[nid][anomid] = 1
            end
            visradius = radius + (rdelta[nid][anomid] or 0)
            if laststate[nid] then
                visradius = visradius + 1
            end
        end

        if hasanom and anomid and cls and 
           ogse_anomaly.get_anomaly_mode(nil, anomid) ~= "anom_off" and 
           self.npc:name() ~= "bar_ecolog_professor" and 
           not string.find(self.npc:character_community() or "", "zombied") and 
           dist and dist < visradius 
        then
            -- Проверим не болтается ли NPC рядом с аномалией слишком долго
            if stucktime[nid][anomid] == nil or stucktime[nid][anomid] < time_global() - 120000 then
                stucktime[nid][anomid] = time_global() + 60000
                rdelta[nid][anomid] = 1
                
                -- Проверим обнаружил ли сталкер аномалию
                local rank_name = ranks.get_obj_rank_name(self.npc)
                local errortbl = error_tbl[rank_name]
                if errortbl then
                    local errorrate = errortbl[cls]
                    if errorrate and math.random(0, 100) <= errorrate then
                        -- Сталкер облажался. Ставим ему аномалию в игнор
                        stucktime[nid][anomid] = time_global() - 1
                    end
                end
            end
            
            if stucktime[nid][anomid] and stucktime[nid][anomid] < time_global() and dist > radius * 0.9 then
                -- Всё чувак. Твое время истекло. Выбирайся как хочешь.
                laststate[nid] = false
            else
                laststate[nid] = true
            end
        else
            laststate[nid] = false
        end
    end
    
    return laststate[nid]
end

class "action_evade_anomaly" (action_base)

function action_evade_anomaly:__init(npc_name, action_name, storage, char_ini) 
    super(nil, action_name)
    self.a = storage
end

local can_rethink = {}
local reverse = {}
local npcpostime = {}

function action_evade_anomaly:initialize()
    action_base.initialize(self)
    self.object:set_desired_position()
    self.object:set_desired_direction()
    self.object:set_detail_path_type(move.line)
    self.object:set_path_type(game_object.level_path)
    self.object:movement_enabled(true)
    self.object:set_body_state(move.standing)
    self.object:set_movement_type(move.walk)
    self.prefdir = self.object:direction()

    local nid = self.object:id()
    npcpostime[nid] = {pos = self.object:position(), time = time_global() + 4000}
end

function veceq(v1, v2)
    if not v1 or not v2 then return false end
    return math.abs(v1.x - v2.x) < 0.5 and 
           math.abs(v1.y - v2.y) < 0.5 and
           math.abs(v1.z - v2.z) < 0.5
end

function action_evade_anomaly:execute()
    action_base.execute(self)
    local nid = self.object:id()
    
    -- Инициализация таблиц
    if rdelta[nid] == nil then rdelta[nid] = {} end
    
    if can_rethink[nid] == nil or can_rethink[nid] < time_global() then
        local flag, anomid, anpos, cls, dist, radius = anomaly_holder.get_nearest_anomaly(self.object, self.prefdir)
        
        if flag and anomid and anpos and radius then
			-- Ray Twitty aka Shadows: в некоторых случаях не инициализировано и вызывает зависание биндера НПС
            if rdelta[nid][anomid] == nil then
                rdelta[nid][anomid] = 1
            end
            
            local current_pos = self.object:position()
            if npcpostime[nid] and veceq(current_pos, npcpostime[nid].pos) and time_global() > npcpostime[nid].time then
                reverse[nid] = not reverse[nid]
                rdelta[nid][anomid] = (rdelta[nid][anomid] or 0) + 0.25
            elseif not (npcpostime[nid] and veceq(current_pos, npcpostime[nid].pos)) then
                -- Обновим координату и время
                npcpostime[nid] = {pos = current_pos, time = time_global() + 6000}
            end
            
            local anvec = vector():set(anpos):sub(current_pos)
            anvec.y = 0
            anvec:normalize()
            local mydir = self.prefdir
            
            -- проверим куда надо поворачивать
            local newdir
            local angle = math.random(80, 100)
            
            if dist and dist < radius * 0.9 then
                angle = math.random(120, 240)
                self.object:set_movement_type(move.walk)
                reverse[nid] = false
            end
            
            if reverse[nid] then
                angle = -angle
            end
            
            if mydir.x * anvec.z - mydir.z * anvec.x < 0 then
                newdir = vector_rotate_y(anvec, angle)
            else
                newdir = vector_rotate_y(anvec, -angle)
            end
            
            local vertex_id = level.vertex_in_direction(self.object:level_vertex_id(), newdir, 1)
            can_rethink[nid] = time_global() + 1000
            
            if vertex_id then
                utils.send_to_nearest_accessible_vertex(self.object, vertex_id)
            end
        end
    end
end

function action_evade_anomaly:finalize()
    action_base.finalize(self)
end

function add_to_binder(object, char_ini, scheme, section, st)
    local manager = object:motivation_action_manager()
    local properties = {}
    properties["wounded"] = xr_evaluators_id.sidor_wounded_base

    -- Evaluators
    manager:add_evaluator(1099, evaluator_anomaly(st, object, "evaluator_anomaly"))
    
    -- Actions
    local action = action_evade_anomaly(object:name(), "action_evade_anomaly", st, char_ini)
    action:add_precondition(world_property(stalker_ids.property_alive, true))
    action:add_precondition(world_property(properties["wounded"], false))
    action:add_precondition(world_property(ogsm_hideout.property_hideout_lost, false))
    action:add_precondition(world_property(ogsm_hideout.property_inhide, false))
    action:add_precondition(world_property(1099, true))
    action:add_effect(world_property(1099, false))
    manager:add_action(10032, action)

    action = manager:action(xr_actions_id.alife) 
    action:add_precondition(world_property(1099, false))  
    action = manager:action(stalker_ids.action_combat_planner) 
    action:add_precondition(world_property(1099, false))  
end

function set_evade(npc, ini, scheme, section)
    local st = xr_logic.assign_storage_and_bind(npc, ini, scheme, section)
end

function reset_evade(npc, scheme, st, section)
end

