-- new arena

function arena_has_reward ()
	return has_alife_info("bar_arena_fight_1_reward") or has_alife_info("bar_arena_fight_2_reward") or has_alife_info("bar_arena_fight_3_reward") or has_alife_info("bar_arena_fight_4_reward") or has_alife_info("bar_arena_fight_5_reward") 
		or has_alife_info("bar_arena_fight_6_reward") or has_alife_info("bar_arena_fight_7_reward") or has_alife_info("bar_arena_fight_8_reward")
end

function arena_hasnt_reward ()
	return not
		( 
			has_alife_info("bar_arena_fight_1_reward") or has_alife_info("bar_arena_fight_2_reward") or has_alife_info("bar_arena_fight_3_reward") or has_alife_info("bar_arena_fight_4_reward") or has_alife_info("bar_arena_fight_5_reward") 
			or has_alife_info("bar_arena_fight_6_reward") or has_alife_info("bar_arena_fight_7_reward") or has_alife_info("bar_arena_fight_8_reward")
		)
end

function arena_rank_check_true ()
	if has_alife_info("bar_arena_fight_6_done") or has_alife_info("bar_arena_fight_3_done") then
		if has_alife_info("bar_arena_fight_3_done") and (db.actor:character_rank() >= 300) and not(has_alife_info("bar_arena_fight_6_done")) then
			return true
		end
	elseif has_alife_info("bar_arena_fight_6_done") and (db.actor:character_rank() >= 600) then
		return true 	
	else 
		return false
	end
end

function arena_rank_check_false ()
	return not arena_rank_check_true ()
end

--' final update, делаем нормальные метки
function locate_bar_bar(actor,npc)
	level_tasks.add_location_by_sid(story_ids.bar_bar_locator, "bar_location", "bar_bar_locator")
end

function locate_bar_arena(actor,npc)
	level_tasks.add_location_by_sid(story_ids.bar_arena_locator, "arni_location", "bar_arena_locator")
end

function locate_bar_dolg(actor,npc)
	level_tasks.add_location_by_sid(story_ids.bar_dolg_locator, "base_location", "bar_voronin_name")
end

function del_bar_bar(actor,npc)
	level_tasks.remove_location_by_sid(story_ids.bar_bar_locator, "bar_location", "bar_bar_locator")
end

function del_bar_arena(actor,npc)
	level_tasks.remove_location_by_sid(story_ids.bar_arena_locator, "arni_location", "bar_arena_locator")
end

function del_bar_dolg(actor,npc)
	level_tasks.remove_location_by_sid(story_ids.bar_dolg_locator, "base_location", "bar_voronin_name")
end

function loc_info()
	db.actor:give_info_portion("l05_bar_level_info")
end

-- Dolg info
function is_dolg_info()
	if has_alife_info("dolg_info_about_bar") and
		has_alife_info("dolg_info_about_arena") and
		has_alife_info("dolg_info_about_dolg")
	then
		return false
	end
	return true 
end

-- Barman info
function is_barman_info()
	if has_alife_info("barman_info_about_self") and
		has_alife_info("barman_info_about_ghost") and
		has_alife_info("barman_info_about_fang") and
		has_alife_info("barman_info_about_sci") and
		has_alife_info("barman_info_about_monolit")
	then
		return false
	end
	return true 
end
