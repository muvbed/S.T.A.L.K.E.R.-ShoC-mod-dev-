function arena_give_reward(actor, npc)
	local m = 0
	if has_alife_info("bar_arena_fight_1_reward") then
		dialogs.relocate_money(npc, 500, "in")
		dialogs.relocate_item_section(npc, "ammo_9x18_pmm", "in")
		dialogs.relocate_item_section(npc, "mutant_boar_leg", "in")
	elseif has_alife_info("bar_arena_fight_2_reward") then
		dialogs.relocate_money(npc, 700, "in")
		dialogs.relocate_item_section(npc, "ammo_5.45x39_fmj", "in")
		dialogs.relocate_item_section(npc, "ammo_9x19_fmj", "in")
		dialogs.relocate_item_section(npc, "energy_drink", "in")
	elseif has_alife_info("bar_arena_fight_3_reward") then
		dialogs.relocate_money(npc, 2500, "in")
		dialogs.relocate_item_section(npc, "ammo_12x76_zhekan", "in")
		dialogs.relocate_item_section(npc, "ammo_12x76_dart", "in")
		dialogs.relocate_item_section(npc, "mutant_psevdodog_tail", "in")
		dialogs.relocate_item_section(npc, "medkit", "in")
		dialogs.relocate_item_section(npc, "wpn_addon_silencer", "in")
	elseif has_alife_info("bar_arena_fight_4_reward") then
		dialogs.relocate_money(npc, 3400, "in")
		dialogs.relocate_item_section(npc, "ammo_12x70_buck", "in")
		dialogs.relocate_item_section(npc, "ammo_5.45x39_ap", "in")
		dialogs.relocate_item_section(npc, "vodka", "in")
		dialogs.relocate_item_section(npc, "conserva", "in")
	elseif has_alife_info("bar_arena_fight_5_reward") then
		dialogs.relocate_money(npc, 4800, "in")
		dialogs.relocate_item_section(npc, "ammo_9x39_sp5", "in")
		dialogs.relocate_item_section(npc, "antirad", "in")
		dialogs.relocate_item_section(npc, "medkit_army", "in")
	elseif has_alife_info("bar_arena_fight_6_reward") then
		dialogs.relocate_money(npc, 6100, "in")
		dialogs.relocate_item_section(npc, "af_vyvert", "in")
		dialogs.relocate_item_section(npc, "ammo_11.43x23_fmj", "in")
		dialogs.relocate_item_section(npc, "ammo_5.56x45_ss190", "in")
	elseif has_alife_info("bar_arena_fight_7_reward") then
		dialogs.relocate_money(npc, 7600, "in") 
		dialogs.relocate_item_section(npc, "af_fireball", "in")
		dialogs.relocate_item_section(npc, "ammo_9x19_pbp", "in")
		dialogs.relocate_item_section(npc, "ammo_7.62x54_7h14", "in")
		dialogs.relocate_item_section(npc, "ammo_vog-25", "in")
		dialogs.relocate_item_section(npc, "wpn_knife", "in")
	elseif has_alife_info("bar_arena_fight_8_reward") then
		dialogs.relocate_money(npc, 10000, "in")
		dialogs.relocate_item_section(npc, "vodka", "in")
		dialogs.relocate_item_section(npc, "vodka", "in")
		dialogs.relocate_item_section(npc, "vodka", "in")
		dialogs.relocate_item_section(npc, "ammo_5.56x45_ss190", "in")
		dialogs.relocate_item_section(npc, "ammo_5.56x45_ap", "in")
		dialogs.relocate_item_section(npc, "wpn_sig_m1", "in")
	end
	db.actor:give_info_portion("bar_arena_reset")	
	xr_zones.purge_arena_items("bar_arena")
end


