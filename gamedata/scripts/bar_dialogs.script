function professor_for_resque(npc, actor)
	-- nv140420
	if not has_alife_info("bar_ecolog_research_normal") then
		dialogs.relocate_item_section(npc, "bar_ecolog_flash", "in")
		db.actor:give_info_portion("bar_ecolog_research_normal")
	end
end

-- Ecolog info
function is_ecolog_info()
	if has_alife_info("bar_ecolog_crush_professor_info_about_where") and 
		has_alife_info("bar_ecolog_crush_professor_info_about_zone") and
		has_alife_info("bar_ecolog_crush_professor_info_about_merc")
	then
		if has_alife_info("bar_x16_documents_start") then
			if not has_alife_info("bar_ecolog_crush_professor_info_about_lab") then
				return true
			end
		end
		return false
	end
	return true 
end

