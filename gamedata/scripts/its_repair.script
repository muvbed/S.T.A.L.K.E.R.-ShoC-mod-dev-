local new_cost = true				-- (Опционально) Другая формула подсчёта стоимости ремонта
local coef_cost_wpn = 1.5			-- Коэффициенты на которые умножается конечная стоимость ремонта оружия
local coef_cost_outfit = 1.5		-- и брони

local w1_selected
local w2_selected
local w4_selected
local o_selected

local snd_slot = xr_sound.get_safe_sound_object("interface\\inv_slot")
local snd_r_w = xr_sound.get_safe_sound_object("interface\\inv_repair_short")
local snd_r_o = xr_sound.get_safe_sound_object("interface\\inv_repair_outfit_short")


function main(npc,actor)
	local hud = repair_ui(get_hud())
	level.start_stop_menu(hud, true)

	db.actor:hide_weapon()
end


class "repair_ui" (CUIScriptWnd)

function repair_ui:__init(owner) super()
	self.owner = owner
	self:Init_Controls()
	self:InitCallBacks()
end
 

function repair_ui:__finalize()
end
 
function repair_ui:Init_Controls()
	local xml = CScriptXmlInit()

	self:Init(350,130,774,642)
	xml:ParseFile("ui_repair_16.xml")

	xml:InitStatic("main_window", self)
	self:Register(xml:Init3tButton("btn_quit", self),"btn_quit")

	self:Register(xml:Init3tButton("repair_title_1", self),"repair_title_1")
	
	self:Register(xml:InitStatic("money_static", self), "money_static")
	self:Register(xml:InitStatic("money_count_static", self), "money_count_static")
	self:actor_money()

	w1_selected = false
	w2_selected = false
	w4_selected = false
	o_selected = false
	
	self:Register(xml:InitStatic("repair_cost", self), "repair_cost")
	self:Register(xml:InitStatic("repair_cost_count", self), "repair_cost_count")
	self:Register(xml:InitStatic("repair_cost_count_red", self), "repair_cost_count_red")
	self:draw_cost()
	
	self:Register(xml:Init3tButton("btn_repair", self),"btn_repair")
	self:GetButton("btn_repair"):Enable(false)

	self:Register(xml:InitStatic("s_weapon_1", self), "s_weapon_1")
	self:GetStatic("s_weapon_1"):Show(false)
	self:Register(xml:InitStatic("s_weapon_2", self), "s_weapon_2")
	self:GetStatic("s_weapon_2"):Show(false)
	self:Register(xml:InitStatic("s_weapon_4", self), "s_weapon_4")
	self:GetStatic("s_weapon_4"):Show(false)
	self:Register(xml:InitStatic("s_outfit", self), "s_outfit")
	self:GetStatic("s_outfit"):Show(false)

	-- Вывод иконки Оружия слота 1
	if db.actor:item_in_slot(1) ~= nil then
		local weapon_1_name = db.actor:item_in_slot(1):section()
          	local x, y, width, height, y_fix, x_fix, w_fix = icon_pos(weapon_1_name,1)
          	local weapon_tex = CUIStatic()

		self:Register(xml:Init3tButton("h_weapon_1", self),"h_weapon_1")
		if db.actor:item_in_slot(1):condition() <= 0.99 and db.actor:item_in_slot(1):condition() >= 0.10 then
			self:GetButton("h_weapon_1"):Enable(true)
		else
			self:GetButton("h_weapon_1"):Enable(false)
		end

      	weapon_tex:SetAutoDelete(true)
      	self:AttachChild(weapon_tex)	
      	weapon_tex:InitTexture("ui\\ui_icon_equipment")
      	weapon_tex:SetStretchTexture(true)
      	weapon_tex:SetOriginalRect(x, y, width, height)
		weapon_tex:Init((12 + x_fix), (30 + y_fix), w_fix, height)
	end

	-- Вывод иконки Оружия слота 2
	if db.actor:item_in_slot(2) ~= nil then
		local weapon_2_name = db.actor:item_in_slot(2):section()
		local x, y, width, height, y_fix, x_fix, w_fix = icon_pos(weapon_2_name,2)
		local weapon_tex = CUIStatic()

		self:Register(xml:Init3tButton("h_weapon_2", self),"h_weapon_2")
		if db.actor:item_in_slot(2):condition() <= 0.99 and db.actor:item_in_slot(2):condition() >= 0.10 then
			self:GetButton("h_weapon_2"):Enable(true)
		else
			self:GetButton("h_weapon_2"):Enable(false)
		end

		weapon_tex:SetAutoDelete(true)
		self:AttachChild(weapon_tex)	
		weapon_tex:InitTexture("ui\\ui_icon_equipment")
		weapon_tex:SetStretchTexture(true)
		weapon_tex:SetOriginalRect(x, y, width, height)
		weapon_tex:Init((12 + x_fix), (128 + y_fix), w_fix, height)
	end
	
	-- Вывод иконки Оружия слота 4
	if db.actor:item_in_slot(4) ~= nil 
		and db.actor:item_in_slot(4):section() ~= "racya_b" 
		and db.actor:item_in_slot(4):section() ~= "wpn_binoc"
	then
		local weapon_4_name = db.actor:item_in_slot(4):section()
		local x, y, width, height, y_fix, x_fix, w_fix = icon_pos(weapon_4_name,4)
		local weapon_tex = CUIStatic()

		self:Register(xml:Init3tButton("h_weapon_4", self),"h_weapon_4")
		if db.actor:item_in_slot(4):condition() <= 0.99 and db.actor:item_in_slot(4):condition() >= 0.10 then
			self:GetButton("h_weapon_4"):Enable(true)
		else
			self:GetButton("h_weapon_4"):Enable(false)
		end

		weapon_tex:SetAutoDelete(true)
		self:AttachChild(weapon_tex)	
		weapon_tex:InitTexture("ui\\ui_icon_equipment")
		weapon_tex:SetStretchTexture(true)
		weapon_tex:SetOriginalRect(x, y, width, height)
		weapon_tex:Init((78 + x_fix), (222 + y_fix), w_fix, height)
	end

	-- Вывод иконки Брони
	if db.actor:item_in_slot(6) ~= nil then
		local outfit_name = db.actor:item_in_slot(6):section()
		local x, y, width, height, y_fix, x_fix, w_fix, h_fix = icon_pos(outfit_name,6)
		local weapon_tex = CUIStatic()

		self:Register(xml:Init3tButton("h_outfit", self),"h_outfit")
		if db.actor:item_in_slot(6):condition() <= 0.99 and db.actor:item_in_slot(6):condition() >= 0.10 then
			self:GetButton("h_outfit"):Enable(true)
		else
			self:GetButton("h_outfit"):Enable(false)
		end

		weapon_tex:SetAutoDelete(true)
		self:AttachChild(weapon_tex)	
		weapon_tex:InitTexture("ui\\ui_icon_equipment")
		weapon_tex:SetStretchTexture(true)
		weapon_tex:SetOriginalRect(x, y, width, height)
		weapon_tex:Init((30 + x_fix), (220 + y_fix), w_fix, h_fix)
	end

	self:Register(xml:InitStatic("cond_1_100", self), "cond_1_100")
	self:Register(xml:InitStatic("cond_1_90", self), "cond_1_90")
	self:Register(xml:InitStatic("cond_1_0", self), "cond_1_0")
	self:Register(xml:InitStatic("cond_2_100", self), "cond_2_100")
	self:Register(xml:InitStatic("cond_2_90", self), "cond_2_90")
	self:Register(xml:InitStatic("cond_2_0", self), "cond_2_0")
	self:Register(xml:InitStatic("cond_4_100", self), "cond_4_100")
	self:Register(xml:InitStatic("cond_4_90", self), "cond_4_90")
	self:Register(xml:InitStatic("cond_4_0", self), "cond_4_0")
	self:Register(xml:InitStatic("cond_6_100", self), "cond_6_100")
	self:Register(xml:InitStatic("cond_6_90", self), "cond_6_90")
	self:Register(xml:InitStatic("cond_6_0", self), "cond_6_0")
	self:cond_upd()
end

------------------ Callback на нажатие кнопок --------------------------------

function repair_ui:InitCallBacks()
	self:AddCallback("h_weapon_1", ui_events.BUTTON_CLICKED, self.h_weapon_1, self)
	self:AddCallback("h_weapon_2", ui_events.BUTTON_CLICKED, self.h_weapon_2, self)
	self:AddCallback("h_weapon_4", ui_events.BUTTON_CLICKED, self.h_weapon_4, self)
	self:AddCallback("h_outfit", ui_events.BUTTON_CLICKED, self.h_outfit, self)
	self:AddCallback("btn_repair", ui_events.BUTTON_CLICKED, self.repiar, self)
	self:AddCallback("btn_quit", ui_events.BUTTON_CLICKED, self.on_quit, self)
end

------------------------------------------------------------------------------

function repair_ui:actor_money()
	local actor_money =  db.actor:money()
	self:GetStatic("money_count_static"):SetText(actor_money .. " RU")
end

-- Ф-ции по выбору предмета мышкой
function repair_ui:h_weapon_1()
	if not w1_selected then
		w1_selected = true
		self:GetStatic("s_weapon_1"):Show(true)
		self:indicators_upd()
		self:draw_cost()
		if snd_slot then snd_slot:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 2.0) end
	else
		w1_selected = false
		self:GetStatic("s_weapon_1"):Show(false)
		self:indicators_upd()
		self:draw_cost()
		if snd_slot then snd_slot:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 2.0) end
	end
end

