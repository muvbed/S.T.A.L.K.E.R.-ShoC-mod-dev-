function proceed()
    local actor = db.actor
       	
	if actor:object ("bandit_flash") then 
	   db.actor:give_info_portion("mil_bandit_flash_get")  
	end

	if actor:object ("ugrum_flash") then 
	   db.actor:give_info_portion("mil_ugrum_flash_get")  
	end

	if actor:object ("max_flash") then 
	   db.actor:give_info_portion("mil_max_owner_flash_get")  
	end
	
	if actor:object ("crazy_flash") then
	   db.actor:give_info_portion("crazy_info")  
	end
end

--' final update, изворачиваемся с метками квеста и вырезаем рудименты
function process_info_portion(info_id)
	if info_id == "mil_rg6_gain" then       
		level_tasks.set_task_state (task.completed, "mil_freedom_rg6_task", 3) 
		level_tasks.set_task_state (task.completed, "mil_freedom_rg6_task", 0) 

	elseif info_id == "mil_max_arrive" then
		db.actor:disable_info_portion ("mil_lukash_go_to_max")

	elseif info_id == "mil_cook_question_already" and not has_alife_info("mil_svoboda_rg6_gain") then
		level_tasks.add_location_by_sid(story_ids.Mil_Cook, "cookfix_location", "mil_rg6_hint2")

	elseif info_id == "mil_freedom_cook_rg6_ask" then
		level_tasks.remove_location_by_sid(story_ids.Mil_Cook, "cookfix_location")
		
	elseif info_id == "mil_lukash_blockpost" then
		level_tasks.add_location_by_sid(story_ids.Mil_Kap, "blue_location", "mil_cap_hint")    
		
	elseif info_id == "mil_fblockpost_quest_reward" or this.fblockpost_job_failed() then
		level_tasks.remove_location_by_sid(story_ids.Mil_Kap, "blue_location", "mil_cap_hint")     
	
	end
	
	return false
end

function set_cook_mapspot ()
   level_tasks.add_location_by_sid(story_ids.Mil_Cook, "mil_cook_location")
end

