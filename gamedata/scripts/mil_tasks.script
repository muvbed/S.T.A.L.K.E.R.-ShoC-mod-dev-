function final_subtask_dolg_main (task_id, subtask)
    return has_alife_info("mil_lukash_dead") 
    	and (has_alife_info("mil_dolg_dead") or has_alife_info("mil_dolg_task_final"))
end

function dolg_job_fail1 (task_id, subtask)
    return has_alife_info("mil_scull_dead") 
    	or has_alife_info("mil_dolg_dead")
    	or this.is_actor_enemy_dolg() 
    	or xr_effects.is_actor_enemy(708) 
end

function dolg_job_fail2 (task_id, subtask)
    return has_alife_info("mil_dolg_dead")
    	or this.is_actor_enemy_dolg()
    	or xr_effects.is_actor_enemy(708) 
end

function is_actor_enemy_dolg ()
    return xr_gulag.isGulagEnemy( "mil_dolg", db.actor ) 
    	or db.actor:character_community() == "actor_freedom"
end

function is_actor_enemy_freedom ()
    return xr_gulag.isGulagEnemy( "mil_freedom", db.actor ) 
    	or db.actor:character_community() == "actor_dolg"
end

function check_murder(victim)
	local victim_smart = dsh_enemies.get_smart_terrain(victim)
    
    if victim_smart then
    	if victim_smart:name() == "mil_dolg" then
			if db.actor:character_community() ~= "actor_dolg" then
				xr_gulag.setGulagEnemy("mil_dolg", db.actor)
			end
		
			if has_alife_info("mil_lukash_dolg_task_reject") 
			  and not mil_tasks.is_actor_enemy_freedom() then
				db.actor:give_info_portion("mil_lukash_dolg_task")
			end
		elseif victim_smart:name() == "mil_freedom" then
			if db.actor:character_community() ~= "actor_freedom" 
			  and victim:character_community() ~= "prefreedom" then
				xr_gulag.setGulagEnemy("mil_freedom", db.actor)
			end
		
			if not has_alife_info("mil_dolg_final_task") 
			  and (has_alife_info("mil_dolg_skull_talk") or has_alife_info("mil_dolg_auto_attack")) 
			  and not has_alife_info("mil_dolg_dead") 
			  and not mil_tasks.is_actor_enemy_dolg() then
				db.actor:give_info_portion("mil_dolg_final_task")
			end
		elseif victim_smart:name() == "mil_monolit" then
			if not this.is_actor_enemy_freedom() 
			  and not xr_gulag.isGulagEnemy( "mil_fblockpost", db.actor ) 
			  and not has_alife_info("mil_fblockpost_quest") then 
			    db.actor:give_info_portion("mil_fblockpost_quest")
			end
		end
	end
end

function bloodsuckers_dead (task_id, subtask)
    local actor = db.actor
    if has_alife_info ("mil_bloodsucker1_dead") == true and 
       has_alife_info ("mil_bloodsucker2_dead") == true and
	   has_alife_info ("mil_bloodsucker3_dead") == true and  
       has_alife_info ("mil_bloodsucker4_dead") == true then
       return true
    end   
    return false
end
