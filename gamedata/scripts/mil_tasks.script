-- test !!!
function mil_test_task_rg6_have ()
    return db.actor:object ("wpn_pk") ~= nil
end  

function mil_test_task_lr300_have ()
    return db.actor:object ("wpn_m4") ~= nil
end    

function mil_task_rg6_have(task_id, subtask)
	local obj = db.actor:object("wpn_pk")
    if obj ~= nil then
		return true
	end
	return false
end

function mil_task_crazy_flash_have (task_id, subtask)
    if db.actor:object ("crazy_flash") ~= nil then
		if not has_alife_info("mil_max_flash_get") then
			db.actor:give_info_portion ("mil_max_flash_get")
		end
       return true
    end
    return false    
end

function switch_mutants_online (task_id, subtask)
    db.actor:disable_info_portion ("mil_mutants_offline")
end

function fail_rg6_task (task_id, subtask)
    if has_alife_info("mil_cook_dead")
      or xr_effects.is_actor_enemy(728) 
      or this.is_actor_enemy_freedom() then
       return true
    end
    return false   
end

function full_fail_rg6_task ()
    if xr_effects.is_actor_enemy(507) 
      or db.actor:character_community() == "actor_freedom" then
       return true
    end
    return false   
end

function lukash_job_fail (task_id, subtask)
    if has_alife_info("mil_lukash_dolg_task_fail") 
       or xr_effects.is_actor_enemy(707) 
       or this.is_actor_enemy_freedom() 
    then
       return true
    end
    return false     
end

function lukash_job_max_fail (task_id, subtask)
    if this.lukash_job_fail()
       or has_alife_info("mil_max_dead") 
       or has_alife_info("mil_lukash_dolg_task_reject") 
       or xr_effects.is_actor_enemy(702) then
       return true
    end
    return false     
end

