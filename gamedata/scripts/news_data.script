        chat3 = "Да ладно тебе. Чувак, за косарь подгоню. В Тёмной Долине, в деревне около ворот на Кордон.",
        chat4 = "Да пошли вы. Обращаешься как к человеку, а в ответ..."
    },
    {
        chat1 = "Как выйти на Болотного Доктора? Мутит уже второй день, подыхаю.",
        chat2 = "Знаю только точно, что на Болотах он уже не обитает. Вроде как куда-то к Радару попёрся.",
        chat3 = "А я слышал, что он около Армейских Складов. В общем да, где-то на севере.",
        chat4 = "Блин. Реально подохну скоро. Ещё волдыри какие-то..."
    },
    {
        chat1 = "Где можно пушкой хорошей разжиться? Надоело с пуколкой бегать да с двухстволкой.",
        chat2 = "Значит, смотри. Стволами торгуют Сидорович, Бармен в \"100 Рентген\", на вертушке иногда прилетает торгаш какой-то из-за периметра, вроде как есть ещё один мужик на Агропроме, но точно не знаю. Кто там ещё есть...",
        chat3 = "На Свалке тёмный мужик какой-то стволы толкает. Какие-то типы ещё Гаусс-пушку продавали в Тёмной Долине, у дороги на Кордон.",
        chat4 = "О, спасибо, мужики!"
    },
    {
        chat1 = "Сидорович, маячки ещё есть в продаже?",
        chat2 = "Были, вчера только у него видел. Только консервные банки ему не неси, а то опять ругался...",
        chat3 = "Какие нафиг маячки, зачем они?",
        chat4 = "Возможно, я тебя удивлю, но тут один барыга ещё и замки продаёт! А зачем - включай голову, авось дойдёт."
    },
    {
        chat1 = "Видел группу каких-то левых мужиков, предположительно \"Свобода\", идут в сторону Бара.",
        chat2 = "Ах ты сволочь...",
        chat3 = "Да пусть сами разбираются, стукачить-то зачем?",
        chat4 = "Блин, сорян, мужики, я ж не со зла..."
    },
    {
        chat1 = "Нужен нормальный выход в интернет. В баре есть, или к Сидоровичу плестись?",
        chat2 = "У Бармена вроде был. В принципе, можешь попробовать пойти к связистам \"Долга\", у них точно доступ имеется.",
        chat3 = "Только один хрен, на халяву никто попользоваться не даст.",
        chat4 = "Ясен-красен. В Зоне просто так даже мухи не... Короче, понял, спасибо."
    },
    {
        chat1 = "Мужики, знает кто, можно как-то ПДА перенастроить, чтобы сигнал недругов мог ловить? Бандиты заманали...",
        chat2 = "Головастики у Бармена в подсобке занимаются. Только денег гребут... Манал я их с такими ценами.",
        chat3 = "Точно, Доцент или как там его. Вроде сигнал и на отслеживание двухсотых настраивает, полезная штука. С тебя пузырь за инфу!",
        chat4 = "Жизнь важнее фантиков. Накопим и поставим. Спасибо, мужики, должен буду!"
    }
