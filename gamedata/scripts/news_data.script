weather_templates_day    = {
    ["clear"] = { "Эх, какая погода классная! И не верится, что Зона...", "А погода всё-таки супер. Позагорать бы. :)",
        "Тучка прячется за лес,\\nСмотрит солнышко с небес.\\nИ такое чистое,\\nДоброе, лучистое...\\n\\nЭх, что-то меня на лирику потянуло...",
        "В такую погоду пикник на обочине бы устроить...", "Надеюсь, такая погода надолго, ибо дорога мне предстоит неблизкая...",
        "Как хорошо-то на улице, аж материться не хочется!", "Ляпота-то на улице какая, красота!", "Ну, в такую погоду и в ходку можно!",
        "Хорошо на улице, атмосферненько...", "Солнце, конечно, дело хорошее, лучи вот только в прицел бьют..." },
    ["cloudy"] = { "Что-то хмурится. Как бы дождь не пошёл...", "Тучи какие-то мрачные...", "Сдаётся, дождь будет. А мы только за хабаром собрались...",
        "Что-то пасмурно...", "Похоже, солнца мы ещё долго не увидим.", "Что ни говори, а именно сейчас та самая атмосфера Зоны!",
        "Серость-то какая на улице, тьфу.", "Н-да, похоже, щас на улице несладко будет, пора норку поютнее искать.",
        "Блин, неужели всё на дождь?! Только снарягу в ходку собрал!", "М-да, мрачновато на улице, однако." },
    ["partly"] = { "Кажется, дождь начнётся щас...", "Ну вот - опять дождь будет.", "Ну и кто там рассказывал, что будет хорошая погода?",
        "Кто знает, такая погода вообще закончится когда-нибудь?", "Опять сейчас лить и лить будет...",
        "Дробь дождя по тёмным крышам – \\nПерезвоны кастаньет. \\nТихий шорох еле слышен \\nВ сером дыме сигарет. \\nРастворились ароматы \\nС неба льющейся воды... \\nИ под звонкие раскаты \\nСоткан мир из пустоты. \\n\\nЭх... А я ведь когда-то серьёзно стихи писал.",
        "М-да, вот и дождик сейчас пойдёт...", "Я же говорил - будет дождь.",
        "И вновь дожди обрушились на землю,\\nИ капли разрывают тишину.\\nВокруг вода стекает с мутной пеной,\\nСмывая за собой пожухлую листву.",
        "Ниче, дождик сейчас пройдёт, зато по грибы сходим потом! :)" },
    ["rain"] = { "Всё льёт и льёт...", "Блин, я весь насквозь уже, опять потом сушиться полдня!", "Ёпть, ну и погодка!", "Блин, опять подошве гаплык в такую-то погоду!",
        "Писец на улице, мужики, подтягивайтесь по норам!", "Да, не повезло тем, кто щас в рейде по радиоактивной целине топает...",
        "Надо было ватные сапоги брать, в этих берцах все ноги тут оставлю...", "Мля, надеюсь, в такую погоду хоть мутанты к нам не сунутся...",
        "Как бы постройки такую погоду выдержали...", "Хорошо, хоть водкой запасся, манал я такие стихийные бедствия." },
    ["storm"] = { "Ого, нехилая гроза будет.", "Слышали гром? Бабахнуло неслабо.", "У нас тут такое светопредставление - молнии лупят, не переставая.",
        "Интересно, гроза вообще прекратится?", "Вот блин! Только соберёшься идти - сразу дождь как из ведра.", "Гром гремит. Значит, не просто дождик - гроза.",
        "Гром гремит, кусты трясутся...", "Чё на улице-то происходит? Выброс, что ли?!", "Да-а-а, природные катаклизмы тут похлеще домашних...",
        "В такую погоду свои дома сидят, телевизор смотрят. Только чужие шастают..." },
    ["beta"] = { "А вот и солнышко выглянуло.", "Я же говорил - погода будет хорошая.", "Ух, как здорово! Все тучи разошлись.", "Хорошо, хоть дождь закончился.",
        "Хоть капать перестало.", "Похоже, дождь закончился.", "Не радуйтесь, что дождь закончился - на тучи посмотрите.", "Ну чё, мужики, за грибами?!",
        "Ну всё, рюкзак за спину, ноги в руки и вперёд!", "Да, не выброс, конечно, но и такая погода тут жуть наводит." },
    ["foggy"] = { "Чёт вспоминается мультик - \"Ёжик в тумане\"...", "Не влететь бы в этом тумане куда...", "В \"Радоново облако\" бы не влететь в такую-то погоду...",
        "Ло-шад-каааааааа!", "Ну и сырость на улице, мерзость.", "Погода самое оно для диверсии на базу недругов. Главное, чтобы не к нам.",
        "М-да, в такую погоду и противотуманки не в помощь...", "Пожалуй, подожду, как туман рассеется, потом в ходку, чего и вам советую.",
        "Мужики, не рискуйте в такую погоду за хабаром лазить, подкараулят вас на раз-два.", "Вроде и светло уже, а не видно ни зги..." }
}

weather_templates_night  = {
    ["clear"] = { "Эх, ночь-то какая красивая, спокойная, романтизьм просто!", "Мужики, на небо хоть посмотрите - ясное, звёздное, что аж глаз не оторвать!",
        "А на улице тишь да гладь, таки даёт Зона передохнуть брату-сталкеру...", "Тихо светит луна, ла-ла-ла, там вдали за рекою...\\nНе обессудьте, мужики, навеяло.",
        "Ох, надеюсь, до утра такая погодка, ибо шпёхать мне ещё..." },
    ["cloudy"] = { "Блин, чёт не разберу, тучи, что ли, собираются...", "Н-да, затягивается небо, не все звёзды успел я ещё сосчитать.",
        "Ёпть, как бы дождь щас не ливанул, опять с утра грязь месить...", "И так ночью несладко, дык ещё всё небо тучи затянули!",
        "Блин, как бы дождь не пошёл, мне ещё всю ночь караул нести..." },
    ["partly"] = { "Ну всё, пойдёт сейчас вода горячая, только просох!", "М-мать, заморосит сейчас всё-таки, я утром в ходку собрался!",
        "Мужики, знает кто, надолго такая погодка? До обеда всё рассосалось бы.", "Только всё испортил, моросящий дождь. :(",
        "Ёпта, чё там закапало-то, только спать собрался!" },
    ["rain"] = { "Ну и писец на улице, хоть сон отбило.", "Как бы в такую погоду тварь какая не подобралась бы...",
        "Радует Зона погодкой, видимо, перед Выбросом нервишки тренирует.", "Ничё, парни, не дрейфь, щас утихнет погодка.",
        "Да-а-а, не повезло теперь на улице какому-нибудь заблудшему бедолаге..." },
    ["storm"] = { "Ну чё, поспали, мужики?! А вот хер вам!", "Сука! Только уснул! Ба-бах!!!", "Чё за светопредставление на улице? Сидор салюты завёз?",
        "Да, мля, поспал перед вылазкой...", "Ну и херомантия, ночью и так не по себе, а тут на улице долбит ещё." },
    ["beta"] = { "Ну, наконец, всё утихло, может, до утра всё и просохнет.", "Досыпаем, мужики, пока есть возможность.",
        "О, как кстати, дождь кончился, и водка у нас кончилась!", "Как заманала эта погода... Можно хоть денька два тиши да глади?",
        "Н-да, занятная выдалась ночка. Надеюсь, башмаки к утру хоть чуть высохнут." },
    ["foggy"] = { "Туман да ночью?! Удивляешь, Зона, не перестаёшь...", "И так видимости ноль, а тут ещё туман этот... В кусты даже теперь стрёмно сходить.",
        "Хотел с позаранку в ходку сходить, но в такую погоду - я манал.", "Не удивлюсь, если в Зоне щас в тумане самих ёжика и лошадку встречу, м-мать...",
        "Ёпта, то ли показалось, то ли щас в полумраке из тумана два глаза на меня загорелись. Ну нафиг..." }
}

