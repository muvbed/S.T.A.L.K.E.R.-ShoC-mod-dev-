-- здесь заводим источники сигналов для ламп и прожекторов, работающих по расписанию
-- ключ - имя сигнала
-- значение - таблица с расписанием включения/выключения в формате {t1, -t2, t3, -t4}
-- где tx - время переключения в часах (число с плавающей запятой)
-- знак (плюс/минус) - определяет включение или выключение соответственно, плюс ставить не обязательно

light_schedules = {
	ligh_schedule_common_day_night = {-6, 22}, -- расписание для большинства уличных ламп
	ligh_schedule_blockhaus_day_night = {-6, 22}, -- расписание для прожекторов на блокпосту
	yan_sci_base_schedule = {-7, 20},
}