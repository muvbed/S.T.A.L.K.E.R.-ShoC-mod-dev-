-- Эффект от удара по морде (Muvbed)
function actor_punch(npc)
	if not db.actor:alive() then return end
	if db.actor:position():distance_to_sqr(npc:position()) > 3.24 then
		return
	end
	
	local active_item = db.actor:active_item()
	if active_item then
		bind_stalker.hide_weapon()
		bind_stalker.restore_weapon()
	end

	level.disable_input()

	dsh.timeout( 1000, function()
		level.enable_input()
	end )
	
	local snd_obj = xr_sound.get_safe_sound_object([[affects\hit_fist]])
	if snd_obj then
		snd_obj:play_no_feedback(db.actor, sound_object.s2d, 0, vector(), 1.0)
	end
	
	local h = hit()
	h.draftsman = db.actor
	h.type = hit.strike
	h.direction = vector():set(0, 0, 0)
	h:bone("bip01_head")
	h.power = 0.1
	h.impulse = 0
	db.actor:hit(h)

	level.add_cam_effector("camera_effects\\fusker.anm",959,false,"")
	level.add_pp_effector("facer.ppe",959,false)
	level.set_pp_effector_factor(959,0.15)
	level.add_pp_effector("wink.ppe",960,false)
end

