function mil_emeny_nearest (actor, npc)
    if actor == nil or actor:alive () == false then
       return
    end    

    if xr_gulag.isGulagEnemy( "mil_freedom", actor ) then
       actor:give_info_portion ("mil_enemy_nearest")
    end
end


