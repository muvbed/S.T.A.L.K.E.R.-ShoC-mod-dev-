--' Смена группировки солдат на настоящих военных
function esc_bridge_set_mil()	
	for id, _ in pairs(db.creature) do
		local obj = level.object_by_id(id)

		if obj 
		  and obj:is_stalker() 
		  and obj:character_community() == "premilitary" 
		  and obj:alive() 
		then
			obj:set_character_community( "military", 0, 0 )
		end
	end
end

