function blowout_hours()
    local hours = level.get_time_hours()
    if hours > 5 and hours < 21 then
        return "day"
    end
    return "night"
end

function start_small_reject (actor, npc)
	this.aes_earthshake()
end

function start_prepare_reject (actor, npc)
	log3("start_prepare_reject")
    local hours_type = blowout_hours()
    level.set_weather_fx("fx_blowout_" .. hours_type)
	this.aes_earthshake()
end

