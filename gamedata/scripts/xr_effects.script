function is_actor_enemy(story_id)
	if story_id then
		local npc = level_object_by_sid (story_id)
		local actor = db.actor
		
		if npc and actor then
			local t = db.storage[npc:id()].death
			return npc:relation(actor) == game_object.enemy or (t ~= nil and t.killer == actor:id())
		end
	end
    return false
end

